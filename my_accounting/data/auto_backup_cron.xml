<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

    <!-- نسخة احتياطية كاملة كل يوم؛ تتحقق الدالة من تفعيل الخيار في الإعدادات -->
    <record id="ir_cron_myaccounting_auto_backup" model="ir.cron">
        <field name="name">المحاسبة المخصصة: نسخة احتياطية يومية</field>
        <field name="model_id" ref="model_myaccounting_backup"/>
        <field name="state">code</field>
        <field name="code">model.run_auto_backup()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
        <field name="nextcall" eval="(DateTime.now().replace(hour=2, minute=0, second=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
    </record>

    </data>
</odoo>
