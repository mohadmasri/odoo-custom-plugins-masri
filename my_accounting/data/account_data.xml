<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_myaccounting_move" model="ir.sequence">
            <field name="name">تسلسل القيود المحاسبية</field>
            <field name="code">myaccounting.move</field>
            <field name="prefix">QID/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_myaccounting_account" model="ir.sequence">
            <field name="name">تسلسل رموز الحسابات</field>
            <field name="code">myaccounting.account</field>
            <field name="padding">3</field>
            <field name="number_next">504</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
