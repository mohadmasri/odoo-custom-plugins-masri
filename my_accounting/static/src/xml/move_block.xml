<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="my_accounting.MoveBlockBar">
      <div class="o_move_block_wrap">
        <div t-if="!readonly" class="o_move_block_bar">
            <span class="o_move_block_label">كتلة جاهزة:</span>
            <button t-foreach="data.blocks" t-as="block" t-key="block.id"
                    type="button" class="btn btn-sm btn-outline-primary"
                    t-att-title="block.hint"
                    t-on-click="() => this.open(block)">
                <i t-attf-class="fa {{ block.icon }} me-1"/>
                <t t-esc="block.name"/>
            </button>
            <button type="button" class="btn btn-sm btn-link o_move_block_manage"
                    title="إدارة الكتل الجاهزة"
                    t-on-click="() => this.openSettings()">
                <i class="fa fa-cog"/>
            </button>
            <span t-if="!data.blocks.length" class="o_move_block_note">
                لا توجد كتل بعد — أنشئها من الإعدادات.
            </span>
        </div>
      </div>
    </t>

    <t t-name="my_accounting.MoveBlockDialog">
        <Dialog title="'كتلة ' + block.name" size="'lg'">
            <div class="o_move_block_dialog" t-on-keydown="(ev) => this.onKeydown(ev)">
                <div t-if="block.hint" class="text-muted small mb-3" t-esc="block.hint"/>

                <div class="row g-2 mb-3">
                    <div class="col-12 col-md-6">
                        <label class="form-label small mb-1">البيان</label>
                        <input type="text" class="form-control form-control-sm" autofocus="autofocus"
                               placeholder="يُكتب على كل بند ما لم يكن للبند بيان خاص"
                               t-model="state.text"/>
                    </div>
                    <div t-foreach="block.fields" t-as="field" t-key="field.key"
                         class="col-6 col-md-3">
                        <label class="form-label small mb-1" t-esc="field.label"/>
                        <input type="number" step="0.001"
                               class="form-control form-control-sm text-end"
                               t-att-value="state.values[field.key]"
                               t-on-input="(ev) => this.onValue(field.key, ev)"/>
                    </div>
                </div>

                <div t-if="askedLines.length" class="row g-2 mb-3">
                    <div t-foreach="askedLines" t-as="line" t-key="line.id"
                         class="col-12 col-md-4">
                        <label class="form-label small mb-1"
                               t-esc="line.account_prompt or 'الحساب'"/>
                        <input type="text" class="form-control form-control-sm"
                               t-att-list="listId" placeholder="اختر الحساب"
                               t-att-value="accountLabel(state.accounts[line.id])"
                               t-on-change="(ev) => this.onAccountInput(line.id, ev)"/>
                    </div>
                </div>

                <datalist t-att-id="listId">
                    <option t-foreach="props.accounts" t-as="acc" t-key="acc.id"
                            t-att-value="acc.label"/>
                </datalist>

                <!-- البنود كما ستُضاف تماماً -->
                <table class="table table-sm o_move_block_preview mb-2">
                    <thead>
                        <tr>
                            <th>البيان</th>
                            <th>الحساب</th>
                            <th class="text-end">الدائن</th>
                            <th class="text-end">المدين</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="lines" t-as="line" t-key="line.key">
                            <td t-esc="line.name"/>
                            <td t-esc="accountLabel(line.account_id) or '—'"
                                t-att-class="line.account_id ? '' : 'text-danger'"/>
                            <td class="text-end"
                                t-esc="line.credit ? line.credit.toFixed(3) : (line.credit_zero_entered ? '0.000' : '')"/>
                            <td class="text-end"
                                t-esc="line.debit ? line.debit.toFixed(3) : (line.debit_zero_entered ? '0.000' : '')"/>
                        </tr>
                    </tbody>
                </table>

                <div t-if="problem" class="alert alert-warning py-1 px-2 small mb-0" t-esc="problem"/>
            </div>

            <t t-set-slot="footer">
                <button class="btn btn-primary" t-att-disabled="problem"
                        t-on-click="() => this.confirm()">أضف البنود</button>
                <button class="btn btn-secondary" t-on-click="() => this.props.close()">إلغاء</button>
            </t>
        </Dialog>
    </t>

</templates>
