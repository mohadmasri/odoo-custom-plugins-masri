<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="my_accounting.BankStatement">
        <div class="o_bank_statement p-3">

            <div class="d-flex justify-content-between align-items-center mb-3 no-print">
                <h2 class="m-0">كشف البنك</h2>
                <div class="d-flex gap-2 align-items-center">
                    <select class="form-select form-select-sm" style="width:200px;"
                            t-att-disabled="state.busy"
                            t-on-change="(ev) => this.onAccount(ev)">
                        <option t-foreach="state.accounts" t-as="account" t-key="account.id"
                                t-att-value="account.id"
                                t-att-selected="account.id === state.accountId">
                            <t t-esc="account.code"/> — <t t-esc="account.name"/>
                        </option>
                    </select>
                    <label class="btn btn-primary btn-sm mb-0">
                        <i class="fa fa-upload me-1"/> ارفع كشفاً (PDF)
                        <input type="file" accept=".pdf" class="d-none"
                               t-att-disabled="state.busy"
                               t-on-change="(ev) => this.onFile(ev)"/>
                    </label>
                    <button t-if="data" class="btn btn-secondary btn-sm"
                            t-on-click="() => this.print()">
                        <i class="fa fa-print me-1"/> طباعة
                    </button>
                </div>
            </div>

            <div t-if="state.statements.length" class="o_bs2_bar no-print">
                <label class="form-label small mb-0">كشف محفوظ</label>
                <select class="form-select form-select-sm" style="width:340px;"
                        t-on-change="(ev) => this.openStatement(ev)">
                    <option t-foreach="state.statements" t-as="item" t-key="item.id"
                            t-att-value="item.id" t-att-selected="isStatement(item.id)">
                        <t t-esc="item.name"/> — <t t-esc="item.date_from"/> ←
                        <t t-esc="item.date_to"/> (<t t-esc="item.lines"/> حركة)
                    </option>
                </select>
                <button t-if="data" class="btn btn-sm btn-outline-secondary"
                        t-att-disabled="state.busy" t-on-click="() => this.rematch()">
                    أعد الفحص
                </button>
                <button t-if="data" class="btn btn-sm btn-link text-danger"
                        t-att-disabled="state.busy" t-on-click="() => this.deleteStatement()">
                    احذف الكشف
                </button>
            </div>

            <div t-if="state.loading" class="text-muted py-5 text-center">يُحمّل...</div>
            <div t-elif="state.busy" class="text-muted py-5 text-center">يُقرأ الكشف...</div>
            <div t-elif="!data" class="text-muted py-5 text-center">
                لا كشف بعد. نزّل كشف الحساب من البنك وارفعه هنا.
            </div>

            <t t-else="">
                <div class="o_bs2_head">
                    <div class="o_bs2_print_title">
                        كشف البنك — <t t-esc="data.account"/>
                        <span t-if="state.kind" class="o_bs2_print_kind">
                            · <t t-esc="kindLabel"/>
                        </span>
                    </div>
                    <div>
                        <b t-esc="data.name"/> · حساب <t t-esc="data.bank_account_number"/> ·
                        من <t t-esc="data.date_from"/> إلى <t t-esc="data.date_to"/>
                    </div>
                    <div class="small text-muted">
                        <t t-esc="data.lines.length"/> حركة ·
                        ظهرت في القيود <b t-esc="data.matched_count"/> ·
                        لم تظهر <b t-esc="data.unmatched_count"/>
                        (<t t-esc="fmt(data.unmatched_total)"/>)
                        <span t-if="!data.check.closing_ok" class="o_bs2_bad ms-2">
                            تنبيه: قراءة الملف لا تطابق مجاميع الكشف
                        </span>
                        <span t-else="" class="ms-2">
                            · الرصيد الختامي <t t-esc="fmt(data.closing_balance)"/>
                            مطابق لما يقوله البنك
                        </span>
                    </div>
                </div>

                <ul class="nav nav-tabs mb-2 no-print">
                    <li class="nav-item">
                        <a href="#" t-attf-class="nav-link {{ isKind('') ? 'active' : '' }}"
                           t-on-click.prevent="() => this.setKind('')">
                            الكل <span class="o_bs2_count" t-esc="data.lines.length"/>
                        </a>
                    </li>
                    <li t-foreach="kinds" t-as="kind" t-key="kind.key" class="nav-item">
                        <a href="#" t-attf-class="nav-link {{ isKind(kind.key) ? 'active' : '' }}"
                           t-on-click.prevent="() => this.setKind(kind.key)">
                            <t t-esc="kind.label"/>
                            <span class="o_bs2_count" t-esc="kind.count"/>
                            <span t-if="kind.missing" class="o_bs2_count_missing">
                                <t t-esc="kind.missing"/> لم تظهر
                            </span>
                        </a>
                    </li>
                </ul>

                <div class="o_bs2_bar no-print">
                    <label class="form-check-label small">
                        <input type="checkbox" class="form-check-input me-1"
                               t-att-checked="state.onlyMissing"
                               t-on-change="() => this.toggleMissing()"/>
                        أظهر ما لم يظهر في القيود فقط
                    </label>
                </div>

                <table class="table table-bordered table-sm o_bs2_table">
                    <thead>
                        <tr>
                            <th style="width:92px;">التاريخ</th>
                            <th>بيان البنك</th>
                            <th class="text-end" style="width:105px;">وارد</th>
                            <th class="text-end" style="width:105px;">صادر</th>
                            <th class="text-end" style="width:115px;">الرصيد</th>
                            <th style="width:300px;">القيد / الشرح</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="rows" t-as="line" t-key="line.id"
                            t-attf-class="{{ line.matched ? 'o_bs2_matched' : 'o_bs2_missing' }}">
                            <td t-esc="line.date"/>
                            <td dir="ltr" class="o_bs2_raw" t-esc="line.label"/>
                            <td class="text-end"
                                t-esc="line.amount > 0 ? fmt(line.amount) : ''"/>
                            <td class="text-end"
                                t-esc="line.amount &lt; 0 ? fmt(-line.amount) : ''"/>
                            <td class="text-end" t-esc="fmt(line.balance)"/>
                            <td>
                                <t t-if="line.matched">
                                    <a href="#" class="o_bs2_link"
                                       t-custom-click="(ev, mid) => this.openMove(line.move_id, mid)">
                                        قيد <t t-esc="line.move"/>
                                    </a>
                                    <span class="o_bs2_label" t-esc="line.move_label"/>
                                    <span t-if="line.guess" class="o_bs2_guess"
                                          title="طوبقت بالمبلغ لا برقم الشيك — راجعها">
                                        ترجيح بالمبلغ
                                    </span>
                                </t>
                                <t t-else="">
                                    <span class="o_bs2_tag">لم تظهر</span>
                                    <span t-if="line.note" class="o_bs2_note2" t-esc="line.note"/>
                                </t>
                            </td>
                        </tr>
                        <tr t-if="!rows.length">
                            <td colspan="6" class="text-muted text-center py-2">لا حركات</td>
                        </tr>
                    </tbody>
                </table>
            </t>
        </div>
    </t>

</templates>
