<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- خانة تختار حساباً أو باباً أو بنداً، بالكتابة مع قائمة مطابقة -->
    <t t-name="my_accounting.RefPicker">
        <div class="o_bs_picker" t-ref="root">
            <input type="text" class="form-control form-control-sm"
                   t-att-placeholder="props.placeholder or 'اكتب اسم الحساب أو الباب...'"
                   t-att-value="state.text" t-att-disabled="props.disabled"
                   t-on-input="(ev) => this.onInput(ev)"
                   t-on-focus="() => this.onFocus()"
                   t-on-blur="() => this.onBlur()"
                   t-on-keydown="(ev) => this.onKeydown(ev)"/>
            <div t-if="state.open" class="o_bs_picker_menu">
                <div t-foreach="matches" t-as="option" t-key="option.token"
                     t-attf-class="o_bs_picker_item {{ isActive(option_index) ? 'o_bs_picker_on' : '' }}"
                     t-on-mousedown.prevent="() => this.choose(option)">
                    <span t-esc="option.display"/>
                    <span t-if="option.hint" class="o_bs_picker_hint" t-esc="option.hint"/>
                </div>
                <div t-if="!matches.length" class="o_bs_picker_empty">لا مطابق</div>
            </div>
        </div>
    </t>

    <!-- جانب من جوانب الميزانية: أبوابه وحساباتها وبنوده المحسوبة -->
    <t t-name="my_accounting.BalanceSheetSide">
        <t t-foreach="sections" t-as="section" t-key="section.id">
            <tr class="o_bs_root">
                <td t-esc="section.label"/>
                <td class="text-end" t-esc="fmt(section.total)"/>
            </tr>
            <t t-foreach="section.lines" t-as="line" t-key="line.id">
                <tr class="o_bs_line"
                    t-custom-click="(ev, mid) => this.openAccount(line.id, mid)">
                    <td t-att-style="indent(line.level)">
                        <t t-esc="line.code"/> <t t-esc="line.name"/>
                    </td>
                    <td class="text-end" t-esc="fmt(line.amount)"/>
                </tr>
            </t>
            <t t-foreach="section.formulas or []" t-as="item" t-key="item.id">
                <tr t-attf-class="o_bs_formula {{ item.bold ? 'o_bs_strong' : '' }}">
                    <td>
                        <t t-esc="item.name"/>
                        <span t-if="item.error" class="o_bs_err" t-esc="item.error"/>
                    </td>
                    <td class="text-end" t-esc="item.error ? '—' : fmt(item.value)"/>
                </tr>
            </t>
        </t>
    </t>

    <!-- بنود محسوبة مستقلة (آخر جانب) -->
    <t t-name="my_accounting.BalanceSheetFormulas">
        <t t-foreach="items" t-as="item" t-key="item.id">
            <tr t-attf-class="o_bs_formula {{ item.bold ? 'o_bs_strong' : '' }}">
                <td>
                    <t t-esc="item.name"/>
                    <span t-if="item.error" class="o_bs_err" t-esc="item.error"/>
                </td>
                <td class="text-end" t-esc="item.error ? '—' : fmt(item.value)"/>
            </tr>
        </t>
    </t>

    <t t-name="my_accounting.BalanceSheet">
        <div class="o_balance_sheet p-3">

            <div class="d-flex justify-content-between align-items-center mb-3 no-print">
                <h2 class="m-0">الميزانية السنوية</h2>
                <div class="d-flex gap-2">
                    <button t-if="state.tab === 'sheet'"
                            t-attf-class="btn btn-sm {{ state.showEmpty ? 'btn-primary' : 'btn-outline-secondary' }}"
                            t-on-click="() => this.toggleEmpty()">
                        الحسابات الصفرية
                    </button>
                    <button class="btn btn-secondary btn-sm" t-on-click="() => this.print()">
                        <i class="fa fa-print me-1"/> طباعة
                    </button>
                </div>
            </div>

            <ul class="nav nav-tabs mb-3 no-print">
                <li class="nav-item">
                    <a href="#" t-attf-class="nav-link {{ state.tab === 'sheet' ? 'active' : '' }}"
                       t-on-click.prevent="() => this.setTab('sheet')">الميزانية</a>
                </li>
                <li class="nav-item">
                    <a href="#" t-attf-class="nav-link {{ state.tab === 'settings' ? 'active' : '' }}"
                       t-on-click.prevent="() => this.setTab('settings')">إعدادات الميزانية</a>
                </li>
            </ul>

            <!-- ============================ إعدادات الميزانية -->
            <t t-if="state.tab === 'settings'">
                <ul class="nav nav-pills mb-3 no-print">
                    <li class="nav-item">
                        <a href="#" t-attf-class="nav-link {{ state.panel === 'groups' ? 'active' : '' }}"
                           t-on-click.prevent="() => this.setPanel('groups')">الأبواب</a>
                    </li>
                    <li class="nav-item">
                        <a href="#" t-attf-class="nav-link {{ state.panel === 'accounts' ? 'active' : '' }}"
                           t-on-click.prevent="() => this.setPanel('accounts')">تصنيف الحسابات</a>
                    </li>
                    <li class="nav-item">
                        <a href="#" t-attf-class="nav-link {{ state.panel === 'lines' ? 'active' : '' }}"
                           t-on-click.prevent="() => this.setPanel('lines')">بنود محسوبة</a>
                    </li>
                </ul>

                <div class="o_bs_savebar">
                    <button class="btn btn-sm btn-primary"
                            t-att-disabled="state.busy or !dirtyPanel"
                            t-on-click="() => this.save()">
                        <i class="fa fa-check me-1"/> حفظ
                    </button>
                    <button class="btn btn-sm btn-outline-secondary"
                            t-att-disabled="state.busy or !dirtyPanel"
                            t-on-click="() => this.cancel()">
                        إلغاء
                    </button>
                    <span t-if="dirtyPanel" class="o_bs_dirty">تغييرات لم تُحفظ</span>
                </div>

                <!-- الأبواب -->
                <div t-if="state.panel === 'groups'" class="o_bs_panel">
                    <div class="small text-muted mb-2">
                        الأبواب التي تُوزَّع عليها الحسابات. "الموضع" يحدّد أتكون في
                        الميزانية أم في نتيجة السنة، و"الطبيعة" أيُعرض رصيدها المدين
                        موجباً أم الدائن.
                    </div>
                    <table class="table table-sm o_bs_groups_table">
                        <thead>
                            <tr>
                                <th style="width:72px;">ترتيب</th>
                                <th>الاسم</th>
                                <th style="width:140px;">الموضع</th>
                                <th style="width:110px;">الطبيعة</th>
                                <th style="width:70px;">حسابات</th>
                                <th style="width:44px;"/>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="state.groups" t-as="group" t-key="group_index">
                                <td>
                                    <input type="number" class="form-control form-control-sm"
                                           t-att-value="group.sequence"
                                           t-att-disabled="state.busy"
                                           t-on-change="(ev) => this.editGroup(group, 'sequence', ev)"/>
                                </td>
                                <td>
                                    <input type="text" class="form-control form-control-sm"
                                           t-att-value="group.name"
                                           t-att-disabled="state.busy"
                                           t-on-change="(ev) => this.editGroup(group, 'name', ev)"/>
                                </td>
                                <td>
                                    <select class="form-select form-select-sm"
                                            t-att-disabled="state.busy"
                                            t-on-change="(ev) => this.editGroup(group, 'kind', ev)">
                                        <option t-foreach="kinds" t-as="kind" t-key="kind.value"
                                                t-att-value="kind.value"
                                                t-att-selected="isValue(group.kind, kind.value)"
                                                t-esc="kind.label"/>
                                    </select>
                                </td>
                                <td>
                                    <select class="form-select form-select-sm"
                                            t-att-disabled="state.busy"
                                            t-on-change="(ev) => this.editGroup(group, 'side', ev)">
                                        <option t-foreach="sides" t-as="side" t-key="side.value"
                                                t-att-value="side.value"
                                                t-att-selected="isValue(group.side, side.value)"
                                                t-esc="side.label"/>
                                    </select>
                                </td>
                                <td class="text-center text-muted" t-esc="group.accounts"/>
                                <td class="text-center">
                                    <button class="btn btn-sm btn-link text-danger p-0" title="حذف الباب"
                                            t-att-disabled="state.busy"
                                            t-on-click="() => this.removeGroup(group_index)">
                                        <i class="fa fa-trash"/>
                                    </button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <button class="btn btn-sm btn-outline-secondary"
                            t-att-disabled="state.busy" t-on-click="() => this.addGroup()">
                        <i class="fa fa-plus me-1"/> باب جديد
                    </button>
                </div>

                <!-- تصنيف الحسابات والرصيد الافتتاحي -->
                <div t-if="state.panel === 'accounts'" class="o_bs_panel">
                    <div class="small text-muted mb-2">
                        الحساب بلا تصنيف خاص يرث تصنيف أبيه، فيجوز أن يبقى الحساب
                        الرئيسي بلا باب وتُوزَّع فروعه على أبواب مختلفة.
                        والرصيد الافتتاحي هو ما يبدأ به الحساب قبل قيود النظام:
                        موجب للمدين وسالب للدائن.
                    </div>
                    <input type="text" class="form-control form-control-sm mb-2"
                           style="max-width:260px;" placeholder="ابحث برمز أو اسم..."
                           t-att-value="state.accountSearch"
                           t-on-input="(ev) => this.onAccountSearch(ev)"/>
                    <div class="o_bs_accounts">
                        <table class="table table-sm o_bs_accounts_table">
                            <thead>
                                <tr>
                                    <th style="width:70px;">الرمز</th>
                                    <th>الحساب</th>
                                    <th style="width:170px;">الباب</th>
                                    <th style="width:130px;">الرصيد الافتتاحي</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="visibleAccounts" t-as="account" t-key="account.id">
                                    <td class="text-muted" t-esc="account.code"/>
                                    <td t-att-style="indent(account.level)" t-esc="account.name"/>
                                    <td>
                                        <select class="form-select form-select-sm"
                                                t-att-disabled="state.busy"
                                                t-on-change="(ev) => this.editAccountGroup(account, ev)">
                                            <option value=""
                                                    t-att-selected="isAccountGroup(account, false)">
                                                <t t-if="account.inherited">
                                                    يرث: <t t-esc="account.effective"/>
                                                </t>
                                                <t t-else="">— بلا تصنيف —</t>
                                            </option>
                                            <option t-foreach="state.groups" t-as="group" t-key="group.id"
                                                    t-att-value="group.id"
                                                    t-att-selected="isAccountGroup(account, group.id)"
                                                    t-esc="group.name"/>
                                        </select>
                                    </td>
                                    <td>
                                        <input type="number" step="0.001"
                                               class="form-control form-control-sm text-end"
                                               t-att-value="account.opening"
                                               t-att-disabled="state.busy"
                                               t-on-change="(ev) => this.editOpening(account, ev)"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- بنود محسوبة -->
                <div t-if="state.panel === 'lines'" class="o_bs_panel">
                    <div class="small text-muted mb-2">
                        بند تُحسب قيمته بخانات: خانة + أو − خانة … وأضف ما شئت.
                        الخانة حساب (ومعه فروعه) أو باب أو بند محسوب آخر،
                        تختاره بالكتابة فتُكمل لك القائمة.
                        والقيمة المستعملة هي القيمة كما تظهر في الميزانية،
                        والبنود لا تدخل في المجاميع لأنها مشتقة منها.
                    </div>
                    <table class="table table-sm o_bs_lines_table">
                        <thead>
                            <tr>
                                <th style="width:72px;">ترتيب</th>
                                <th style="width:190px;">الاسم</th>
                                <th>المعادلة</th>
                                <th style="width:130px;">الموضع</th>
                                <th style="width:150px;">الباب / الجانب</th>
                                <th style="width:50px;">إبراز</th>
                                <th style="width:44px;"/>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="state.lines" t-as="line" t-key="line_index">
                                <td>
                                    <input type="number" class="form-control form-control-sm"
                                           t-att-value="line.sequence" t-att-disabled="state.busy"
                                           t-on-change="(ev) => this.editLine(line, 'sequence', ev)"/>
                                </td>
                                <td>
                                    <input type="text" class="form-control form-control-sm"
                                           t-att-value="line.name" t-att-disabled="state.busy"
                                           t-on-change="(ev) => this.editLine(line, 'name', ev)"/>
                                </td>
                                <td>
                                    <t t-if="isAdvanced(line)">
                                        <input type="text" class="form-control form-control-sm"
                                               dir="ltr" t-att-value="line.formula"
                                               t-att-disabled="state.busy"
                                               t-on-change="(ev) => this.editLine(line, 'formula', ev)"/>
                                        <div class="o_bs_err">معادلة متقدّمة — تُحرَّر نصاً</div>
                                    </t>
                                    <div t-else="" class="o_bs_terms">
                                        <div t-foreach="terms(line)" t-as="term"
                                             t-key="term_index" class="o_bs_term">
                                            <select t-if="term_index > 0"
                                                    class="form-select form-select-sm o_bs_term_op"
                                                    t-att-disabled="state.busy"
                                                    t-on-change="(ev) => this.onTermSign(line, term_index, ev)">
                                                <option value="+"
                                                        t-att-selected="term.op === '+'">+</option>
                                                <option value="-"
                                                        t-att-selected="term.op === '-'">−</option>
                                            </select>
                                            <RefPicker value="term.token"
                                                       options="state.references"
                                                       disabled="state.busy"
                                                       onSelect="(token) => this.onTermRef(line, term_index, token)"/>
                                            <button class="btn btn-sm btn-link text-danger p-0"
                                                    title="حذف الخانة" t-att-disabled="state.busy"
                                                    t-on-click="() => this.removeTerm(line, term_index)">
                                                <i class="fa fa-times"/>
                                            </button>
                                        </div>
                                        <button class="btn btn-sm btn-outline-secondary o_bs_term_add"
                                                t-att-disabled="state.busy"
                                                t-on-click="() => this.addTerm(line)">
                                            <i class="fa fa-plus me-1"/> خانة
                                        </button>
                                    </div>
                                    <div t-if="lineError(line)" class="o_bs_err"
                                         t-esc="lineError(line)"/>
                                </td>
                                <td>
                                    <select class="form-select form-select-sm"
                                            t-att-disabled="state.busy"
                                            t-on-change="(ev) => this.editLine(line, 'placement', ev)">
                                        <option t-foreach="placements" t-as="place" t-key="place.value"
                                                t-att-value="place.value"
                                                t-att-selected="isPlacement(line, place.value)"
                                                t-esc="place.label"/>
                                    </select>
                                </td>
                                <td>
                                    <select t-if="isPlacement(line, 'group')"
                                            class="form-select form-select-sm"
                                            t-att-disabled="state.busy"
                                            t-on-change="(ev) => this.editLine(line, 'group_id', ev)">
                                        <option value="" t-att-selected="isLineGroup(line, false)">
                                            — اختر باباً —
                                        </option>
                                        <option t-foreach="state.groups" t-as="group" t-key="group.id"
                                                t-att-value="group.id"
                                                t-att-selected="isLineGroup(line, group.id)"
                                                t-esc="group.name"/>
                                    </select>
                                    <select t-elif="isPlacement(line, 'side')"
                                            class="form-select form-select-sm"
                                            t-att-disabled="state.busy"
                                            t-on-change="(ev) => this.editLine(line, 'side', ev)">
                                        <option t-foreach="lineSides" t-as="side" t-key="side.value"
                                                t-att-value="side.value"
                                                t-att-selected="isLineSide(line, side.value)"
                                                t-esc="side.label"/>
                                    </select>
                                    <span t-else="" class="text-muted small">—</span>
                                </td>
                                <td class="text-center">
                                    <input type="checkbox" class="form-check-input"
                                           t-att-checked="line.bold" t-att-disabled="state.busy"
                                           t-on-change="(ev) => this.editLine(line, 'bold', ev)"/>
                                </td>
                                <td class="text-center">
                                    <button class="btn btn-sm btn-link text-danger p-0" title="حذف البند"
                                            t-att-disabled="state.busy"
                                            t-on-click="() => this.removeLine(line_index)">
                                        <i class="fa fa-trash"/>
                                    </button>
                                </td>
                            </tr>
                            <tr t-if="!state.lines.length">
                                <td colspan="7" class="text-muted text-center py-2">لا بنود بعد</td>
                            </tr>
                        </tbody>
                    </table>
                    <button class="btn btn-sm btn-outline-secondary"
                            t-att-disabled="state.busy" t-on-click="() => this.addLine()">
                        <i class="fa fa-plus me-1"/> بند جديد
                    </button>


                </div>
            </t>

            <!-- ============================ الميزانية -->
            <t t-if="state.tab === 'sheet'">
                <div class="o_bs_filter no-print">
                    <label class="form-label small mb-1">السنة</label>
                    <select class="form-select form-select-sm" style="width:120px;"
                            t-on-change="(ev) => this.onYear(ev)">
                        <option t-foreach="data ? data.years : []" t-as="y" t-key="y"
                                t-att-value="y" t-att-selected="isYear(y)" t-esc="y"/>
                    </select>
                </div>

                <div t-if="state.loading" class="text-muted py-5 text-center">تُحسب الميزانية...</div>

                <t t-elif="data">
                    <div class="o_bs_head">
                        <h3 class="m-0">الميزانية كما في نهاية سنة <t t-esc="data.year"/></h3>
                        <div class="small text-muted">
                            الأرصدة الافتتاحية زائد قيود النظام المرحّلة حتى نهاية السنة
                        </div>
                    </div>

                    <div class="o_bs_body">
                        <div class="o_bs_side">
                            <table class="table table-bordered table-sm o_bs_table">
                                <thead>
                                    <tr>
                                        <th>الأصول</th>
                                        <th class="text-end" style="width:140px;">المبلغ</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-call="my_accounting.BalanceSheetSide">
                                        <t t-set="sections" t-value="data.left"/>
                                    </t>
                                    <tr t-if="!data.left.length">
                                        <td colspan="2" class="text-muted text-center py-2">لا أبواب</td>
                                    </tr>
                                    <t t-call="my_accounting.BalanceSheetFormulas">
                                        <t t-set="items" t-value="data.left_formulas"/>
                                    </t>
                                </tbody>
                                <tfoot>
                                    <tr class="o_bs_total">
                                        <td>مجموع الأصول</td>
                                        <td class="text-end" t-esc="fmt(data.assets)"/>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>

                        <div class="o_bs_side">
                            <table class="table table-bordered table-sm o_bs_table">
                                <thead>
                                    <tr>
                                        <th>الخصوم وحقوق الملكية</th>
                                        <th class="text-end" style="width:140px;">المبلغ</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-call="my_accounting.BalanceSheetSide">
                                        <t t-set="sections" t-value="data.right"/>
                                    </t>
                                    <tr class="o_bs_root">
                                        <td>نتيجة السنة</td>
                                        <td class="text-end" t-esc="fmt(data.profit)"/>
                                    </tr>
                                    <tr t-foreach="data.income" t-as="section" t-key="section.id"
                                        class="o_bs_line">
                                        <td t-esc="section.label"/>
                                        <td class="text-end" t-esc="fmt(section.total)"/>
                                    </tr>
                                    <tr t-foreach="data.expense" t-as="section" t-key="section.id"
                                        class="o_bs_line">
                                        <td>ناقص: <t t-esc="section.label"/></td>
                                        <td class="text-end" t-esc="'(' + fmt(section.total) + ')'"/>
                                    </tr>
                                    <t t-call="my_accounting.BalanceSheetFormulas">
                                        <t t-set="items" t-value="data.right_formulas"/>
                                    </t>
                                </tbody>
                                <tfoot>
                                    <tr class="o_bs_total">
                                        <td>مجموع الخصوم وحقوق الملكية</td>
                                        <td class="text-end" t-esc="fmt(data.right_total)"/>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>

                    <div t-if="data.other.length" class="o_bs_other">
                        <table class="table table-bordered table-sm o_bs_table">
                            <thead>
                                <tr>
                                    <th>حسابات غير مصنَّفة</th>
                                    <th class="text-end" style="width:140px;">المبلغ</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-call="my_accounting.BalanceSheetSide">
                                    <t t-set="sections" t-value="data.other"/>
                                </t>
                            </tbody>
                        </table>
                    </div>

                    <div t-if="data.bottom_formulas.length" class="o_bs_other">
                        <table class="table table-bordered table-sm o_bs_table">
                            <thead>
                                <tr>
                                    <th>مؤشرات</th>
                                    <th class="text-end" style="width:140px;">القيمة</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-call="my_accounting.BalanceSheetFormulas">
                                    <t t-set="items" t-value="data.bottom_formulas"/>
                                </t>
                            </tbody>
                        </table>
                    </div>

                    <div t-if="data.balanced" class="o_bs_check o_bs_ok">
                        الجانبان متساويان.
                    </div>
                    <div t-else="" class="o_bs_check o_bs_bad">
                        فرق بين الجانبين: <t t-esc="fmt(data.difference)"/>
                        <t t-if="data.other_total">
                            — منه <t t-esc="fmt(data.other_total)"/> في حسابات غير مصنَّفة.
                        </t>
                    </div>
                </t>
            </t>
        </div>
    </t>

