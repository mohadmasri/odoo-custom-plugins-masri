<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="my_accounting.PrintIndexDialog">
        <Dialog title="'الطباعة'" size="'md'">
            <div dir="rtl">
                <p class="mb-2">هل تريد صفحة فهرس في أول الطباعة؟</p>
                <div class="text-muted small">
                    الفهرس يسرد ما ستطبعه مع رقم صفحة كل عنوان، ويُطبع رقم الصفحة على كل مستند.
                </div>
            </div>
            <t t-set-slot="footer">
                <button t-attf-class="btn {{ suggested ? 'btn-primary' : 'btn-secondary' }}"
                        t-on-click="() => this.choose(true)">
                    <i class="fa fa-list-ol me-1"/>طباعة مع فهرس
                </button>
                <button t-attf-class="btn {{ suggested ? 'btn-secondary' : 'btn-primary' }}"
                        t-on-click="() => this.choose(false)">
                    <i class="fa fa-print me-1"/>طباعة بلا فهرس
                </button>
                <button class="btn btn-light" t-on-click="() => this.props.close()">إلغاء</button>
            </t>
        </Dialog>
    </t>

</templates>
