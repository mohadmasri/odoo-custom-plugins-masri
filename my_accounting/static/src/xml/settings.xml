<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="my_accounting.Settings">
        <div class="o_myaccounting_settings p-4" style="overflow:auto; height:100%;">
            <div class="mb-3">
                <h2 class="m-0">إعدادات أخرى</h2>
                <div class="text-muted small mt-1">إعدادات ووظائف إضافية للنظام</div>
            </div>

            <ul class="nav nav-tabs mb-3">
                <li class="nav-item">
                    <a href="#" t-attf-class="nav-link {{ state.activeTab === 'backup' ? 'active' : '' }}"
                       t-on-click.prevent="() => this.setTab('backup')">
                        <i class="fa fa-database me-1"/> النسخ الاحتياطي
                    </a>
                </li>
                <li class="nav-item">
                    <a href="#" t-attf-class="nav-link {{ state.activeTab === 'journals' ? 'active' : '' }}"
                       t-on-click.prevent="() => this.setTab('journals')">
                        <i class="fa fa-list-ul me-1"/> اليوميات
                    </a>
                </li>
                <li class="nav-item">
                    <a href="#" t-attf-class="nav-link {{ state.activeTab === 'theme' ? 'active' : '' }}"
                       t-on-click.prevent="() => this.setTab('theme')">
                        <i class="fa fa-paint-brush me-1"/> المظهر
                    </a>
                </li>
                <li class="nav-item">
                    <a href="#" t-attf-class="nav-link {{ state.activeTab === 'printIndex' ? 'active' : '' }}"
                       t-on-click.prevent="() => this.setTab('printIndex')">
                        <i class="fa fa-list-ol me-1"/> الفهرس
                    </a>
                </li>
                <li class="nav-item">
                    <a href="#" t-attf-class="nav-link {{ state.activeTab === 'system' ? 'active' : '' }}"
                       t-on-click.prevent="() => this.setTab('system')">
                        <i class="fa fa-power-off me-1"/> النظام
                    </a>
                </li>
            </ul>

            <t t-if="state.activeTab === 'printIndex' and state.printIndex">
                <div class="mb-4" style="max-width: 720px;">
                    <h5 class="mb-1">فهرس الطباعة</h5>
                    <div class="text-muted small mb-3">
                        صفحة أولى تُطبع قبل القيود أو كشوف الحسابات، تسرد ما تطبعه ورقم صفحة كل مستند.
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">عند الطباعة</label>
                        <div class="btn-group d-block" role="group">
                            <t t-foreach="[['ask', 'اسألني في كل مرة'], ['always', 'مع فهرس دائماً'],
                                           ['never', 'بلا فهرس دائماً']]" t-as="mode" t-key="mode[0]">
                                <button type="button"
                                        t-attf-class="btn btn-sm {{ state.printIndex.mode === mode[0] ? 'btn-primary' : 'btn-outline-secondary' }}"
                                        t-on-click="() => this.setIndexMode(mode[0])" t-esc="mode[1]"/>
                            </t>
                        </div>
                    </div>

                    <div class="form-check mb-4">
                        <input type="checkbox" class="form-check-input" id="o_ma_idx_stamp"
                               t-att-checked="state.printIndex.stamp_pages"
                               t-on-change="() => this.toggleIndexColumn('stamp_pages')"/>
                        <label class="form-check-label" for="o_ma_idx_stamp">
                            طباعة رقم الصفحة أعلى كل مستند
                        </label>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <h6 class="fw-bold">كشوف الحسابات</h6>
                            <label class="form-label small mb-1">عنوان صفحة الفهرس</label>
                            <input type="text" class="form-control form-control-sm mb-2"
                                   t-att-value="state.printIndex.title"
                                   t-on-input="(ev) => this.onIndexTitle('title', ev)"/>
                            <label class="form-label small mb-1">الأعمدة</label>
                            <t t-foreach="[['show_seq', 'الرقم التسلسلي'], ['show_code', 'رمز الحساب'],
                                           ['show_name', 'اسم الحساب'], ['show_balance', 'الرصيد']]"
                               t-as="col" t-key="col[0]">
                                <div class="form-check">
                                    <input type="checkbox" class="form-check-input" t-att-id="'o_ma_idx_' + col[0]"
                                           t-att-checked="state.printIndex[col[0]]"
                                           t-on-change="() => this.toggleIndexColumn(col[0])"/>
                                    <label class="form-check-label" t-att-for="'o_ma_idx_' + col[0]" t-esc="col[1]"/>
                                </div>
                            </t>
                        </div>

                        <div class="col-md-6 mb-3">
                            <h6 class="fw-bold">القيود</h6>
                            <label class="form-label small mb-1">عنوان صفحة الفهرس</label>
                            <input type="text" class="form-control form-control-sm mb-2"
                                   t-att-value="state.printIndex.move_title"
                                   t-on-input="(ev) => this.onIndexTitle('move_title', ev)"/>
                            <label class="form-label small mb-1">الأعمدة</label>
                            <t t-foreach="[['move_show_seq', 'الرقم التسلسلي'], ['move_show_name', 'رقم القيد'],
                                           ['move_show_date', 'التاريخ'], ['move_show_ref', 'المرجع'],
                                           ['move_show_total', 'الإجمالي']]"
                               t-as="col" t-key="col[0]">
                                <div class="form-check">
                                    <input type="checkbox" class="form-check-input" t-att-id="'o_ma_idx_' + col[0]"
                                           t-att-checked="state.printIndex[col[0]]"
                                           t-on-change="() => this.toggleIndexColumn(col[0])"/>
                                    <label class="form-check-label" t-att-for="'o_ma_idx_' + col[0]" t-esc="col[1]"/>
                                </div>
                            </t>
                        </div>
                    </div>
                    <div class="form-text mb-3">عمود "الصفحة" يظهر دائماً في الفهرسين.</div>

                    <button class="btn btn-primary" t-att-disabled="state.savingPrintIndex"
                            t-on-click="() => this.savePrintIndex()">
                        <i class="fa fa-save me-1"/>
                        <t t-if="state.savingPrintIndex">جارِ الحفظ...</t>
                        <t t-else="">حفظ</t>
                    </button>
                </div>
            </t>

            <t t-if="state.activeTab === 'theme'">
                <div class="mb-4">
                    <h5 class="mb-1">الوضع</h5>
                    <div class="text-muted small mb-2">يُطبَّق على كل الشاشات، ويُعاد تحميل الصفحة عند التبديل.</div>
                    <div class="d-flex flex-wrap" style="gap: 12px;">
                        <div t-attf-class="o_ma_scheme_card o_ma_scheme_light {{ !isDark ? 'o_selected' : '' }}"
                             t-on-click="() => this.setScheme('light')">
                            <div class="o_ma_scheme_icon"><i class="fa fa-sun-o"/></div>
                            <div>
                                <div class="fw-bold">فاتح</div>
                                <div class="small text-muted">الوضع الافتراضي</div>
                            </div>
                            <i t-if="!isDark" class="fa fa-check-circle text-success ms-auto"/>
                        </div>
                        <div t-attf-class="o_ma_scheme_card o_ma_scheme_dark {{ isDark ? 'o_selected' : '' }}"
                             t-on-click="() => this.setScheme('dark')">
                            <div class="o_ma_scheme_icon"><i class="fa fa-moon-o"/></div>
                            <div>
                                <div class="fw-bold">داكن</div>
                                <div class="small text-muted">مريح للعين ليلاً</div>
                            </div>
                            <i t-if="isDark" class="fa fa-check-circle text-success ms-auto"/>
                        </div>
                    </div>
                </div>

                <div>
                    <h5 class="mb-1">لون الواجهة</h5>
                    <div class="text-muted small mb-2">
                        يغيّر لون الشريط العلوي والأزرار والروابط. يُطبَّق فوراً ويُحفظ لك وحدك،
                        فلكل مستخدم مظهره.
                    </div>
                    <div class="o_ma_theme_grid">
                        <div t-foreach="state.themes" t-as="item" t-key="item.key"
                             t-attf-class="o_ma_theme_card {{ state.theme === item.key ? 'o_selected' : '' }}"
                             t-on-click="() => this.setTheme(item.key)">
                            <div class="o_ma_theme_preview"
                                 t-attf-style="background: linear-gradient(135deg, {{ item.colors[0] }} 0%, {{ item.colors[1] }} 100%);"/>
                            <div class="d-flex align-items-center justify-content-between">
                                <span t-esc="item.name"/>
                                <i t-if="state.theme === item.key" class="fa fa-check-circle text-success"/>
                            </div>
                        </div>
                    </div>
                </div>
            </t>

            <t t-if="state.activeTab === 'backup'">
            <div class="o_settings_section mb-4">
                <div class="o_settings_section_header">
                    <i class="fa fa-database me-2"/>
                    <span>النسخ الاحتياطي والاستعادة</span>
                </div>
                <div class="o_settings_section_body">
                    <div class="o_settings_row">
                        <div class="o_settings_row_text">
                            <div class="o_settings_row_title">تحميل نسخة احتياطية</div>
                            <div class="o_settings_row_desc text-muted small">
                                يقوم بتحميل ملف يحتوي على جميع القيود المحاسبية وشجرة الحسابات الحالية.
                            </div>
                        </div>
                        <button class="btn btn-primary text-nowrap" t-on-click="() => this.downloadBackup()">
                            <i class="fa fa-download me-1"/> تحميل نسخة احتياطية
                        </button>
                    </div>
                    <hr/>
                    <div class="o_settings_row">
                        <div class="o_settings_row_text">
                            <div class="o_settings_row_title text-danger">استعادة نسخة احتياطية</div>
                            <div class="o_settings_row_desc text-muted small">
                                تحذير: سيتم حذف جميع القيود والحسابات الحالية نهائياً، واستبدالها بمحتوى الملف الذي سيتم رفعه.
                            </div>
                        </div>
                        <div class="text-nowrap">
                            <input type="file" accept="application/json,.json" class="d-none" t-ref="fileInput"
                                   t-on-change="(ev) => this.onFileSelected(ev)"/>
                            <button class="btn btn-outline-danger" t-on-click="() => this.triggerFileSelect()"
                                    t-att-disabled="state.restoring">
                                <i class="fa fa-upload me-1"/>
                                <t t-if="state.restoring">جارِ الاستعادة...</t>
                                <t t-else="">رفع واستعادة نسخة</t>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="o_settings_section mb-4" t-if="state.backup">
                <div class="o_settings_section_header">
                    <i class="fa fa-clock-o me-2"/>
                    <span>نسخ احتياطي تلقائي يومي</span>
                </div>
                <div class="o_settings_section_body">
                    <div class="text-muted small mb-3">
                        نسخة كاملة (قاعدة البيانات وكل المرفقات) تُؤخذ تلقائياً كل ليلة الساعة 2 فجراً،
                        وتُحذف النسخ الأقدم تلقائياً. يُفضّل اختيار مجلد على قرص خارجي أو مجلد مزامنة سحابية.
                    </div>
                    <div class="o_settings_row">
                        <div class="o_settings_row_text">
                            <div class="o_settings_row_title">تفعيل النسخ التلقائي</div>
                        </div>
                        <div class="form-check form-switch">
                            <input type="checkbox" class="form-check-input" style="transform:scale(1.4);"
                                   t-att-checked="state.backup.enabled"
                                   t-on-change="(ev) => { state.backup.enabled = ev.target.checked; }"/>
                        </div>
                    </div>
                    <hr/>
                    <div class="d-flex flex-wrap align-items-end mb-2" style="gap: 12px;">
                        <div class="flex-grow-1">
                            <label class="form-label small mb-1">مجلد الحفظ</label>
                            <input type="text" class="form-control form-control-sm"
                                   t-att-value="state.backup.directory"
                                   t-on-change="(ev) => { state.backup.directory = ev.target.value; }"/>
                        </div>
                        <div>
                            <label class="form-label small mb-1">عدد النسخ المحفوظة</label>
                            <input type="number" min="1" max="365" class="form-control form-control-sm"
                                   style="width:120px;" t-att-value="state.backup.keep"
                                   t-on-change="(ev) => { state.backup.keep = ev.target.value; }"/>
                        </div>
                        <button class="btn btn-sm btn-primary" t-att-disabled="state.savingBackup"
                                t-on-click="() => this.saveBackupConfig()">
                            <i class="fa fa-save me-1"/> حفظ الإعدادات
                        </button>
                        <button class="btn btn-sm btn-outline-primary" t-att-disabled="state.runningBackup"
                                t-on-click="() => this.runBackupNow()">
                            <i class="fa fa-download me-1"/>
                            <t t-if="state.runningBackup">جارٍ إنشاء النسخة...</t>
                            <t t-else="">نسخ الآن</t>
                        </button>
                    </div>
                    <div t-if="state.backup.last_status" class="alert alert-info py-2 px-3 small mb-2"
                         t-esc="state.backup.last_status"/>
                    <div t-if="state.backup.files.length" class="small">
                        <strong>النسخ الموجودة (<t t-esc="state.backup.files.length"/>):</strong>
                        <table class="table table-sm mt-1 mb-0">
                            <tbody>
                                <tr t-foreach="state.backup.files.slice(0, 10)" t-as="f" t-key="f.name">
                                    <td t-esc="f.name"/>
                                    <td class="text-muted" t-esc="f.date"/>
                                    <td class="text-end" t-esc="f.size_mb + ' MB'"/>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div t-else="" class="text-muted small">لا توجد نسخ محفوظة بعد في هذا المجلد.</div>
                </div>
            </div>

            </t>

            <t t-if="state.activeTab === 'journals'">
            <div class="o_settings_section mb-4">
                <div class="o_settings_section_header">
                    <i class="fa fa-list-ul me-2"/>
                    <span>اليوميات وقوالب "قيد جديد"</span>
                </div>
                <div class="o_settings_section_body">
                    <div class="text-muted small mb-3">
                        كل يومية تُكتب في قيد تظهر هنا تلقائياً. فعّل الخانة لتظهر اليومية كقالب
                        تحت قائمة "قيد جديد"، ورتّب القائمة بالأسهم.
                    </div>
                    <div t-if="!state.journals.length" class="text-muted">لا توجد يوميات بعد.</div>
                    <table t-if="state.journals.length" class="table table-sm align-middle mb-0">
                        <thead>
                            <tr>
                                <th style="width:90px;">الترتيب</th>
                                <th>اليومية</th>
                                <th style="width:110px;" class="text-center">عدد القيود</th>
                                <th style="width:150px;" class="text-center">في قائمة "قيد جديد"</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="state.journals" t-as="journal" t-key="journal.id">
                                <td>
                                    <button class="btn btn-sm btn-light px-2 py-0" title="تحريك لأعلى"
                                            t-att-disabled="isFirstJournal(journal)"
                                            t-on-click="() => this.moveJournal(journal, -1)">
                                        <i class="fa fa-caret-up"/>
                                    </button>
                                    <button class="btn btn-sm btn-light px-2 py-0 ms-1" title="تحريك لأسفل"
                                            t-att-disabled="isLastJournal(journal)"
                                            t-on-click="() => this.moveJournal(journal, 1)">
                                        <i class="fa fa-caret-down"/>
                                    </button>
                                </td>
                                <td t-esc="journal.name"/>
                                <td class="text-center" t-esc="journal.move_count"/>
                                <td class="text-center">
                                    <input type="checkbox" class="form-check-input"
                                           t-att-checked="journal.show_in_menu"
                                           t-on-change="() => this.toggleJournalMenu(journal)"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            </t>

            <t t-if="state.activeTab === 'system'">
            <div class="o_settings_section mb-4">
                <div class="o_settings_section_header">
                    <i class="fa fa-power-off me-2"/>
                    <span>إعادة تشغيل النظام</span>
                </div>
                <div class="o_settings_section_body">
                    <div class="alert alert-warning py-2 px-3 small">
                        إعادة التشغيل توقف النظام لدقيقة تقريباً وتُخرج كل المستخدمين المتصلين.
                        استخدمها عند بطء النظام أو بعد تغييرات في الإعدادات. احفظ أي قيد مفتوح أولاً.
                    </div>
                    <div class="o_settings_row">
                        <div class="o_settings_row_text">
                            <div class="o_settings_row_title">تأكيد الهوية</div>
                            <div class="o_settings_row_desc text-muted small">
                                أدخل كلمة مرور حسابك الحالي. تُطلب في كل مرة ولا تُحفظ.
                            </div>
                        </div>
                        <div class="d-flex" style="gap: 8px;">
                            <input type="password" class="form-control form-control-sm" style="width:200px;"
                                   autocomplete="off" placeholder="كلمة المرور"
                                   t-att-disabled="state.rebooting"
                                   t-att-value="state.rebootPassword"
                                   t-on-input="(ev) => { state.rebootPassword = ev.target.value; }"/>
                            <button class="btn btn-sm btn-danger text-nowrap"
                                    t-att-disabled="state.rebooting or !state.rebootPassword"
                                    t-on-click="() => this.askReboot()">
                                <i class="fa fa-power-off me-1"/>
                                <t t-if="state.rebooting">جارٍ إعادة التشغيل...</t>
                                <t t-else="">إعادة تشغيل النظام</t>
                            </button>
                        </div>
                    </div>
                    <div t-if="state.rebooting" class="alert alert-info py-2 px-3 small mt-3 mb-0">
                        جارٍ إعادة تشغيل الخادم... ستُحدَّث هذه الصفحة تلقائياً فور عودته.
                    </div>
                </div>
            </div>
            </t>
        </div>
    </t>

</templates>
