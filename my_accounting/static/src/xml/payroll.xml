<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="my_accounting.Payroll">
        <div class="o_payroll p-3">

            <div class="d-flex justify-content-between align-items-center mb-3 no-print">
                <h2 class="m-0">الرواتب</h2>
                <button t-if="data and state.tab === 'sheet'" class="btn btn-secondary btn-sm"
                        t-on-click="() => this.print()">
                    <i class="fa fa-print me-1"/> طباعة
                </button>
            </div>

            <ul class="nav nav-tabs mb-3 no-print">
                <li class="nav-item">
                    <a href="#" t-attf-class="nav-link {{ state.tab === 'sheet' ? 'active' : '' }}"
                       t-on-click.prevent="() => this.setTab('sheet')">كشف الشهر</a>
                </li>
                <li class="nav-item">
                    <a href="#" t-attf-class="nav-link {{ state.tab === 'employees' ? 'active' : '' }}"
                       t-on-click.prevent="() => this.setTab('employees')">
                        الموظفون <span class="o_pr_count" t-esc="state.employees.length"/>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="#" t-attf-class="nav-link {{ state.tab === 'settings' ? 'active' : '' }}"
                       t-on-click.prevent="() => this.setTab('settings')">إعدادات</a>
                </li>
            </ul>

            <div t-if="state.loading" class="text-muted py-5 text-center">يُحمّل...</div>

            <!-- ======================================= كشف الشهر -->
            <t t-elif="state.tab === 'sheet'">
                <div class="o_pr_bar no-print">
                    <select t-if="state.payrolls.length" class="form-select form-select-sm"
                            style="width:260px;" t-on-change="(ev) => this.openPayroll(ev)">
                        <option t-foreach="state.payrolls" t-as="item" t-key="item.id"
                                t-att-value="item.id" t-att-selected="isPayroll(item.id)">
                            <t t-esc="item.name"/>
                            <t t-if="item.state === 'posted'"> — مُرحَّل</t>
                        </option>
                    </select>

                    <span class="o_pr_sep"/>
                    <label class="form-label small mb-0">كشف جديد</label>
                    <select class="form-select form-select-sm" style="width:130px;"
                            t-on-change="(ev) => this.onNew('newMonth', ev)">
                        <option t-foreach="months" t-as="month" t-key="month[0]"
                                t-att-value="month[0]"
                                t-att-selected="month[0] === state.newMonth"
                                t-esc="month[1]"/>
                    </select>
                    <input type="number" class="form-control form-control-sm" style="width:90px;"
                           t-att-value="state.newYear"
                           t-on-change="(ev) => this.onNew('newYear', ev)"/>
                    <button class="btn btn-sm btn-primary" t-att-disabled="state.busy"
                            t-on-click="() => this.createPayroll()">
                        <i class="fa fa-plus me-1"/> أنشئ
                    </button>
                </div>

                <div t-if="!data" class="text-muted py-5 text-center">
                    لا كشف بعد. أضف الموظفين ثم أنشئ كشف الشهر.
                </div>

                <t t-else="">
                    <div class="o_pr_head">
                        <div class="o_pr_print_title">
                            كشف رواتب <t t-esc="data.month_label"/> <t t-esc="data.year"/>
                            <t t-if="monthLabel"> — <t t-esc="monthLabel"/></t>
                        </div>
                        <div class="small text-muted">
                            <t t-esc="visibleCount"/> موظفاً ·
                            <t t-if="posted.length">
                                مُرحَّل إلى
                                <t t-foreach="posted" t-as="done" t-key="done.key">
                                    <a href="#" class="o_pr_link"
                                       t-custom-click="(ev, mid) => this.openMove(done.move_id, mid)">
                                        قيد <t t-esc="done.move"/>
                                    </a><t t-if="!done_last">،</t>
                                </t>
                            </t>
                            <t t-if="toPost.length">
                                <t t-if="posted.length"> · </t>
                                <t t-if="toPost.length === 1">مسودة</t>
                                <t t-else=""><t t-esc="toPost.length"/> كشوف مسودة</t>
                            </t>
                        </div>
                    </div>

                    <div class="o_pr_bar no-print">
                        <button t-if="!data.posted_any" class="btn btn-sm btn-outline-secondary"
                                t-att-disabled="state.busy"
                                t-on-click="() => this.fillFromEmployees()">
                            أعد البناء من بطاقات الموظفين
                        </button>
                        <button t-if="!data.posted_all" class="btn btn-sm btn-primary"
                                t-att-disabled="state.busy or !linesDirty"
                                t-on-click="() => this.saveLines()">حفظ</button>
                        <button t-if="!data.posted_all" class="btn btn-sm btn-outline-secondary"
                                t-att-disabled="state.busy or !linesDirty"
                                t-on-click="() => this.cancelLines()">إلغاء</button>
                        <span t-if="linesDirty" class="o_pr_dirty">تغييرات لم تُحفظ</span>
                        <span class="o_pr_sep"/>
                        <!-- القيد للكشف المعروض وحده: قيدٌ لكل كشف كما في الدفاتر -->
                        <button t-if="toPost.length" class="btn btn-sm btn-success"
                                t-att-disabled="state.busy or linesDirty"
                                t-on-click="() => this.postPayroll()">
                            <i class="fa fa-check me-1"/> <t t-esc="postLabel"/>
                        </button>
                        <button t-if="posted.length" class="btn btn-sm btn-outline-danger"
                                t-att-disabled="state.busy"
                                t-on-click="() => this.unpostPayroll()">
                            <t t-esc="unpostLabel"/>
                        </button>
                        <button t-if="!data.posted_any" class="btn btn-sm btn-link text-danger"
                                t-att-disabled="state.busy"
                                t-on-click="() => this.deletePayroll()">احذف الكشف</button>
                    </div>

                    <!-- كشوف الشهر تبويباتٍ: واحدٌ منها أو عرض الكل -->
                    <ul class="nav nav-pills o_pr_sheets mb-2 no-print"
                        t-if="sheetSections.length > 1">
                        <li class="nav-item">
                            <a href="#" t-attf-class="nav-link {{ state.monthSheet === 'all' ? 'active' : '' }}"
                               t-on-click.prevent="() => this.setMonthSheet('all')">
                                عرض الكل
                                <span class="badge rounded-pill" t-esc="data.lines.length"/>
                            </a>
                        </li>
                        <t t-foreach="state.groups" t-as="group" t-key="group.id">
                            <li class="nav-item" t-if="monthCountOf(group.id)">
                                <a href="#" t-attf-class="nav-link {{ state.monthSheet === group.id ? 'active' : '' }}"
                                   t-on-click.prevent="() => this.setMonthSheet(group.id)">
                                    <t t-esc="group.name"/>
                                    <i t-if="monthPostedOf(group.id)"
                                       class="fa fa-check-circle ms-1" title="مُرحَّل"/>
                                    <span class="badge rounded-pill" t-esc="monthCountOf(group.id)"/>
                                </a>
                            </li>
                        </t>
                        <li class="nav-item" t-if="monthCountOf(false)">
                            <a href="#" t-attf-class="nav-link {{ state.monthSheet === 'none' ? 'active' : '' }}"
                               t-on-click.prevent="() => this.setMonthSheet('none')">
                                بلا كشف
                                <i t-if="monthPostedOf(false)"
                                   class="fa fa-check-circle ms-1" title="مُرحَّل"/>
                                <span class="badge rounded-pill" t-esc="monthCountOf(false)"/>
                            </a>
                        </li>
                    </ul>

                    <table class="table table-bordered table-sm o_pr_table o_pr_month">
                        <thead>
                            <tr>
                                <th class="text-center" style="width:44px;">م</th>
                                <th style="width:170px;">الموظف</th>
                                <th class="text-end" style="width:96px;">الأساسي</th>
                                <th class="text-end" style="width:96px;">العلاوات</th>
                                <th class="text-end" style="width:96px;">الإجمالي</th>
                                <th class="text-end" style="width:96px;">الخاضع للضمان</th>
                                <th class="text-end" style="width:96px;">ضمان الموظف</th>
                                <th class="text-end" style="width:96px;">ضريبة الدخل</th>
                                <th class="text-end" style="width:96px;">صندوق التقاعد</th>
                                <th class="text-end" style="width:96px;">استقطاعات أخرى</th>
                                <th class="text-end" style="width:96px;">مجموع الاستقطاع</th>
                                <th class="text-end" style="width:96px;">الصافي</th>
                                <th class="text-end" style="width:96px;">ضمان الشركة</th>
                            </tr>
                        </thead>
                        <!-- الكشف يسرد بنوده متّصلةً، مرتّبةً بترتيب الكشوف -->
                        <tbody t-foreach="visibleSections" t-as="section" t-key="section.key">
                            <tr t-foreach="section.lines" t-as="line" t-key="line.id">
                                <td class="text-center text-muted"
                                    t-esc="section.start + line_index + 1"/>
                                <td>
                                    <t t-esc="line.employee"/>
                                    <div t-if="line.job_title" class="o_pr_job"
                                         t-esc="line.job_title"/>
                                </td>
                                <t t-if="!section.posted">
                                    <td t-foreach="['basic_salary', 'allowance']" t-as="field"
                                        t-key="field">
                                        <input type="number" step="0.001"
                                               class="form-control form-control-sm text-end"
                                               t-att-value="line[field]"
                                               t-on-change="(ev) => this.editLine(line, field, ev)"/>
                                    </td>
                                    <td class="text-end o_pr_calc" t-esc="fmt(line.gross)"/>
                                    <td t-foreach="['social_base', 'employee_social', 'income_tax', 'pension', 'other_deduction']"
                                        t-as="field" t-key="field">
                                        <input type="number" step="0.001"
                                               class="form-control form-control-sm text-end"
                                               t-att-value="line[field]"
                                               t-on-change="(ev) => this.editLine(line, field, ev)"/>
                                    </td>
                                    <td class="text-end o_pr_calc" t-esc="fmt(line.total_deduction)"/>
                                    <td class="text-end o_pr_calc" t-esc="fmt(line.net)"/>
                                    <td>
                                        <input type="number" step="0.001"
                                               class="form-control form-control-sm text-end"
                                               t-att-value="line.employer_social"
                                               t-on-change="(ev) => this.editLine(line, 'employer_social', ev)"/>
                                    </td>
                                </t>
                                <t t-else="">
                                    <td class="text-end" t-esc="fmt(line.basic_salary)"/>
                                    <td class="text-end" t-esc="fmt(line.allowance)"/>
                                    <td class="text-end" t-esc="fmt(line.gross)"/>
                                    <td class="text-end" t-esc="fmt(line.social_base)"/>
                                    <td class="text-end" t-esc="fmt(line.employee_social)"/>
                                    <td class="text-end" t-esc="fmt(line.income_tax)"/>
                                    <td class="text-end" t-esc="fmt(line.pension)"/>
                                    <td class="text-end" t-esc="fmt(line.other_deduction)"/>
                                    <td class="text-end" t-esc="fmt(line.total_deduction)"/>
                                    <td class="text-end" t-esc="fmt(line.net)"/>
                                    <td class="text-end" t-esc="fmt(line.employer_social)"/>
                                </t>
                            </tr>
                        </tbody>
                        <tbody t-if="!data.lines.length">
                            <tr>
                                <td colspan="13" class="text-muted text-center py-2">
                                    لا بنود. أضف موظفين ثم «أعد البناء».
                                </td>
                            </tr>
                        </tbody>
                        <tbody t-elif="!visibleSections.length">
                            <tr>
                                <td colspan="13" class="text-muted text-center py-2">
                                    لا بنود في هذا الكشف.
                                </td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr class="o_pr_total">
                                <td colspan="2">
                                    <t t-if="monthLabel">مجموع <t t-esc="monthLabel"/></t>
                                    <t t-else="">مجموع الكشف</t>
                                </td>
                                <td class="text-end" t-esc="fmt(visibleTotals.basic_salary)"/>
                                <td class="text-end" t-esc="fmt(visibleTotals.allowance)"/>
                                <td class="text-end" t-esc="fmt(visibleTotals.gross)"/>
                                <td class="text-end" t-esc="fmt(visibleTotals.social_base)"/>
                                <td class="text-end" t-esc="fmt(visibleTotals.employee_social)"/>
                                <td class="text-end" t-esc="fmt(visibleTotals.income_tax)"/>
                                <td class="text-end" t-esc="fmt(visibleTotals.pension)"/>
                                <td class="text-end" t-esc="fmt(visibleTotals.other_deduction)"/>
                                <td class="text-end" t-esc="fmt(visibleTotals.total_deduction)"/>
                                <td class="text-end" t-esc="fmt(visibleTotals.net)"/>
                                <td class="text-end" t-esc="fmt(visibleTotals.employer_social)"/>
                            </tr>
                        </tfoot>
                    </table>

                    <div class="o_pr_note small text-muted">
                        القيد: مصروف الرواتب <t t-esc="fmt(totals.gross)"/> مديناً،
                        وحصة الشركة <t t-esc="fmt(totals.employer_social)"/> مديناً،
                        مقابل الضمان <t t-esc="fmt(totals.employee_social + totals.employer_social)"/>
                        وضريبة الدخل <t t-esc="fmt(totals.income_tax)"/>
                        والمدفوع <t t-esc="fmt(totals.net)"/> دائناً.
                    </div>
                </t>
            </t>

            <!-- ======================================= الموظفون -->
            <t t-elif="state.tab === 'employees' and state.card">
                <!-- ================================= بطاقة الموظف -->
                <div class="o_pr_bar">
                    <button class="btn btn-sm btn-outline-secondary"
                            t-on-click="() => this.closeCard()">
                        <i class="fa fa-arrow-right me-1"/> رجوع إلى الموظفين
                    </button>
                    <span class="o_pr_sep"/>
                    <button class="btn btn-sm btn-primary"
                            t-att-disabled="state.busy or !cardDirty"
                            t-on-click="() => this.saveCard()">حفظ البطاقة</button>
                    <button class="btn btn-sm btn-outline-secondary"
                            t-att-disabled="state.busy or !cardDirty"
                            t-on-click="() => this.cancelCard()">إلغاء</button>
                    <span t-if="cardDirty" class="o_pr_dirty">تغييرات لم تُحفظ</span>
                </div>

                <div class="o_pr_card">
                    <div class="o_pr_card_head">
                        <div>
                            <div class="o_pr_card_name" t-esc="state.card.employee.name"/>
                            <div class="small text-muted">
                                <t t-esc="state.card.employee.job_title or 'بلا مسمّى'"/> ·
                                كشف <t t-esc="state.card.employee.group or 'بلا كشف'"/>
                                <t t-if="!state.card.employee.active"> · ليس على رأس عمله</t>
                            </div>
                        </div>
                        <div class="text-end small text-muted">
                            <div>الصافي الشهري <b t-esc="fmt(state.card.net)"/></div>
                            <div><t t-esc="state.card.months"/> شهراً في السجلّ</div>
                        </div>
                    </div>

                    <!-- بيانات البطاقة: تُكتب هنا لا في جدول الموظفين -->
                    <div class="o_pr_card_grid">
                        <div class="o_pr_card_field" t-foreach="cardFields" t-as="field"
                             t-key="field.name">
                            <label class="form-label small mb-0" t-esc="field.label"/>
                            <input t-att-type="field.type"
                                   class="form-control form-control-sm"
                                   t-att-value="state.cardDraft[field.name]"
                                   t-on-change="(ev) => this.editCard(field.name, ev)"/>
                        </div>
                    </div>

                    <div class="o_pr_card_sub">مكوّنات الراتب <span class="small text-muted">
                        (تُعدَّل من جدول الموظفين)</span></div>
                    <table class="table table-bordered table-sm o_pr_table o_pr_wide">
                        <tbody>
                            <tr>
                                <th>الأساسي</th>
                                <td class="text-end" t-esc="fmt(state.card.employee.basic_salary)"/>
                                <th>العلاوات</th>
                                <td class="text-end" t-esc="fmt(state.card.employee.allowance)"/>
                                <th>الإجمالي</th>
                                <td class="text-end" t-esc="fmt(state.card.employee.gross)"/>
                            </tr>
                            <tr>
                                <th>مشمول بالضمان</th>
                                <td t-esc="state.card.employee.social_security ? 'نعم' : 'لا'"/>
                                <th>الخاضع للضمان</th>
                                <td class="text-end" t-esc="fmt(state.card.social_base)"/>
                                <th>ضمان الموظف</th>
                                <td class="text-end" t-esc="fmt(state.card.employee_social)"/>
                            </tr>
                            <tr>
                                <th>ضريبة الدخل</th>
                                <td class="text-end" t-esc="fmt(state.card.employee.income_tax)"/>
                                <th>صندوق التقاعد</th>
                                <td class="text-end" t-esc="fmt(state.card.employee.pension)"/>
                                <th>استقطاعات أخرى</th>
                                <td class="text-end" t-esc="fmt(state.card.employee.other_deduction)"/>
                            </tr>
                            <tr>
                                <th>الصافي الشهري</th>
                                <td class="text-end" t-esc="fmt(state.card.net)"/>
                                <th/>
                                <td/>
                                <th/>
                                <td/>
                            </tr>
                            <tr>
                                <th>حساب المصروف</th>
                                <td colspan="2" t-esc="state.card.expense_account or 'حساب الرواتب العام'"/>
                                <th>يُدفع من</th>
                                <td colspan="2" t-esc="state.card.payment_account or 'حساب الدفع العام'"/>
                            </tr>
                        </tbody>
                    </table>

                    <div class="o_pr_card_sub">سجلّه الشهري</div>
                    <table class="table table-bordered table-sm o_pr_table o_pr_hist">
                        <thead>
                            <tr>
                                <th style="width:150px;">الشهر</th>
                                <th style="width:140px;">الكشف</th>
                                <th class="text-end" style="width:96px;">الأساسي</th>
                                <th class="text-end" style="width:96px;">العلاوات</th>
                                <th class="text-end" style="width:96px;">الإجمالي</th>
                                <th class="text-end" style="width:96px;">ضمان الموظف</th>
                                <th class="text-end" style="width:96px;">ضريبة</th>
                                <th class="text-end" style="width:96px;">تقاعد</th>
                                <th class="text-end" style="width:96px;">استقطاع</th>
                                <th class="text-end" style="width:96px;">الصافي</th>
                                <th style="width:120px;">القيد</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="state.card.history" t-as="row" t-key="row.id">
                                <td>
                                    <t t-esc="row.month_label"/> <t t-esc="row.year"/>
                                </td>
                                <td t-esc="row.group"/>
                                <td class="text-end" t-esc="fmt(row.basic_salary)"/>
                                <td class="text-end" t-esc="fmt(row.allowance)"/>
                                <td class="text-end" t-esc="fmt(row.gross)"/>
                                <td class="text-end" t-esc="fmt(row.employee_social)"/>
                                <td class="text-end" t-esc="fmt(row.income_tax)"/>
                                <td class="text-end" t-esc="fmt(row.pension)"/>
                                <td class="text-end" t-esc="fmt(row.other_deduction)"/>
                                <td class="text-end" t-esc="fmt(row.net)"/>
                                <td>
                                    <a t-if="row.posted" href="#" class="o_pr_link"
                                       t-custom-click="(ev, mid) => this.openMove(row.move_id, mid)"
                                       t-esc="row.move"/>
                                    <span t-else="" class="text-muted">مسودة</span>
                                </td>
                            </tr>
                            <tr t-if="!state.card.history.length">
                                <td colspan="11" class="text-muted text-center py-2">
                                    لم يدخل في كشف رواتب بعد.
                                </td>
                            </tr>
                        </tbody>
                        <tfoot t-if="state.card.history.length">
                            <tr class="o_pr_total">
                                <td colspan="2">المجاميع</td>
                                <td class="text-end" t-esc="fmt(state.card.totals.basic_salary)"/>
                                <td class="text-end" t-esc="fmt(state.card.totals.allowance)"/>
                                <td class="text-end" t-esc="fmt(state.card.totals.gross)"/>
                                <td class="text-end" t-esc="fmt(state.card.totals.employee_social)"/>
                                <td class="text-end" t-esc="fmt(state.card.totals.income_tax)"/>
                                <td class="text-end" t-esc="fmt(state.card.totals.pension)"/>
                                <td class="text-end" t-esc="fmt(state.card.totals.other_deduction)"/>
                                <td class="text-end" t-esc="fmt(state.card.totals.net)"/>
                                <td/>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </t>

            <t t-elif="state.tab === 'employees'">
                <div class="o_pr_bar">
                    <button class="btn btn-sm btn-primary"
                            t-att-disabled="state.busy or !employeesDirty"
                            t-on-click="() => this.saveEmployees()">حفظ</button>
                    <button class="btn btn-sm btn-outline-secondary"
                            t-att-disabled="state.busy or !employeesDirty"
                            t-on-click="() => this.cancelEmployees()">إلغاء</button>
                    <span t-if="employeesDirty" class="o_pr_dirty">تغييرات لم تُحفظ</span>
                </div>

                <!-- كشوف الموظفين كتبويبات ملف الرواتب نفسها -->
                <ul class="nav nav-pills o_pr_sheets mb-2">
                    <li class="nav-item">
                        <a href="#" t-attf-class="nav-link {{ state.sheet === 'all' ? 'active' : '' }}"
                           t-on-click.prevent="() => this.setSheet('all')">
                            عرض الكل
                            <span class="badge rounded-pill" t-esc="state.employees.length"/>
                        </a>
                    </li>
                    <li class="nav-item" t-foreach="state.groups" t-as="group" t-key="group.id">
                        <a href="#" t-attf-class="nav-link {{ state.sheet === group.id ? 'active' : '' }}"
                           t-on-click.prevent="() => this.setSheet(group.id)">
                            <t t-esc="group.name"/>
                            <span class="badge rounded-pill" t-esc="countOf(group.id)"/>
                        </a>
                    </li>
                    <li class="nav-item" t-if="countOf(false)">
                        <a href="#" t-attf-class="nav-link {{ state.sheet === 'none' ? 'active' : '' }}"
                           t-on-click.prevent="() => this.setSheet('none')">
                            بلا كشف
                            <span class="badge rounded-pill" t-esc="countOf(false)"/>
                        </a>
                    </li>
                </ul>
                <div t-if="currentGroup" class="o_pr_note small text-muted mb-2">
                    كشف <b t-esc="currentGroup.name"/>:
                    المصروف على <b t-esc="currentGroup.account or 'حساب الرواتب العام'"/>،
                    والصافي يُدفع من <b t-esc="currentGroup.payment_account or 'حساب الدفع العام'"/>.
                    وما يُكتب على بطاقةٍ هنا يغلب حساب الكشف.
                </div>

                <table class="table table-bordered table-sm o_pr_table o_pr_emp">
                    <thead>
                        <tr>
                            <th style="width:60px;">ترتيب</th>
                            <th style="width:170px;">الاسم</th>
                            <th style="width:140px;">الكشف</th>
                            <th style="width:110px;">المسمّى</th>
                            <th class="text-end" style="width:96px;">الأساسي</th>
                            <th class="text-end" style="width:96px;">العلاوات</th>
                            <th class="text-center" style="width:56px;">ضمان</th>
                            <th class="text-end" style="width:96px;">الخاضع للضمان</th>
                            <th class="text-end" style="width:96px;">ضريبة</th>
                            <th class="text-end" style="width:96px;">تقاعد</th>
                            <th class="text-end" style="width:96px;">استقطاع</th>
                            <th style="width:170px;">حساب المصروف</th>
                            <th style="width:170px;">يُدفع من</th>
                            <th class="text-center" style="width:56px;">فعّال</th>
                            <th style="width:64px;"/>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="visibleEmployees" t-as="employee" t-key="employee._k">
                            <td>
                                <input type="number" class="form-control form-control-sm"
                                       t-att-value="employee.sequence"
                                       t-on-change="(ev) => this.editEmployee(employee, 'sequence', ev)"/>
                            </td>
                            <td>
                                <input type="text" class="form-control form-control-sm"
                                       t-att-value="employee.name"
                                       t-on-change="(ev) => this.editEmployee(employee, 'name', ev)"/>
                            </td>
                            <td>
                                <RefPicker value="groupToken(employee)"
                                           options="groupOptions"
                                           disabled="state.busy"
                                           placeholder="'بلا كشف'"
                                           onSelect="(token) => this.onEmployeeGroup(employee, token)"/>
                            </td>
                            <td>
                                <input type="text" class="form-control form-control-sm"
                                       t-att-value="employee.job_title"
                                       t-on-change="(ev) => this.editEmployee(employee, 'job_title', ev)"/>
                            </td>
                            <td t-foreach="['basic_salary', 'allowance']" t-as="field" t-key="field">
                                <input type="number" step="0.001"
                                       class="form-control form-control-sm text-end"
                                       t-att-value="employee[field]"
                                       t-on-change="(ev) => this.editEmployee(employee, field, ev)"/>
                            </td>
                            <td class="text-center">
                                <input type="checkbox" class="form-check-input"
                                       t-att-checked="employee.social_security"
                                       t-on-change="(ev) => this.editEmployee(employee, 'social_security', ev)"/>
                            </td>
                            <td t-foreach="['social_base', 'income_tax', 'pension', 'other_deduction']"
                                t-as="field" t-key="field">
                                <input type="number" step="0.001"
                                       class="form-control form-control-sm text-end"
                                       t-att-value="employee[field]"
                                       t-on-change="(ev) => this.editEmployee(employee, field, ev)"/>
                            </td>
                            <td>
                                <RefPicker value="accountToken(employee)"
                                           options="state.accountOptions"
                                           disabled="state.busy"
                                           placeholder="placeholderAccount(employee)"
                                           onSelect="(token) => this.onEmployeeAccount(employee, token)"/>
                            </td>
                            <td>
                                <RefPicker value="paymentToken(employee)"
                                           options="state.accountOptions"
                                           disabled="state.busy"
                                           placeholder="placeholderPayment(employee)"
                                           onSelect="(token) => this.onEmployeePayment(employee, token)"/>
                            </td>
                            <td class="text-center">
                                <input type="checkbox" class="form-check-input"
                                       t-att-checked="employee.active"
                                       t-on-change="(ev) => this.editEmployee(employee, 'active', ev)"/>
                            </td>
                            <td class="text-center">
                                <button class="btn btn-sm btn-link p-0 me-1"
                                        title="بطاقة الموظف"
                                        t-on-click="() => this.openCard(employee)">
                                    <i class="fa fa-id-card-o"/>
                                </button>
                                <button class="btn btn-sm btn-link text-danger p-0"
                                        title="حذف الموظف"
                                        t-on-click="() => this.removeEmployee(employee)">
                                    <i class="fa fa-trash"/>
                                </button>
                            </td>
                        </tr>
                        <tr t-if="!visibleEmployees.length">
                            <td colspan="15" class="text-muted text-center py-2">لا موظفين في هذا الكشف</td>
                        </tr>
                    </tbody>
                    <tfoot t-if="visibleEmployees.length">
                        <tr class="o_pr_total">
                            <td colspan="3">المجاميع</td>
                            <td/>
                            <td class="text-end" t-esc="fmt(employeeTotals.basic_salary)"/>
                            <td class="text-end" t-esc="fmt(employeeTotals.allowance)"/>
                            <td/>
                            <td class="text-end" t-esc="fmt(employeeTotals.social_base)"/>
                            <td class="text-end" t-esc="fmt(employeeTotals.income_tax)"/>
                            <td class="text-end" t-esc="fmt(employeeTotals.pension)"/>
                            <td class="text-end" t-esc="fmt(employeeTotals.other_deduction)"/>
                            <td colspan="4"/>
                        </tr>
                    </tfoot>
                </table>
                <button class="btn btn-sm btn-outline-secondary" t-on-click="() => this.addEmployee()">
                    <i class="fa fa-plus me-1"/> موظف
                    <t t-if="currentGroup"> في <t t-esc="currentGroup.name"/></t>
                </button>
            </t>

            <!-- ======================================= الإعدادات -->
            <t t-elif="state.tab === 'settings' and state.settings">
                <div class="o_pr_bar">
                    <button class="btn btn-sm btn-primary"
                            t-att-disabled="state.busy or !settingsDirty"
                            t-on-click="() => this.saveSettings()">حفظ</button>
                    <button class="btn btn-sm btn-outline-secondary"
                            t-att-disabled="state.busy or !settingsDirty"
                            t-on-click="() => this.cancelSettings()">إلغاء</button>
                    <span t-if="settingsDirty" class="o_pr_dirty">تغييرات لم تُحفظ</span>
                </div>

                <div class="o_pr_panel">
                    <div class="small text-muted mb-2">
                        نِسَب الضمان الاجتماعي، والحسابات التي يُبنى عليها قيد الرواتب.
                    </div>
                    <div class="o_pr_row">
                        <label class="form-label small mb-0">حصة الموظف %</label>
                        <input type="number" step="0.001" class="form-control form-control-sm"
                               style="width:110px;" t-att-value="state.settings.employee_rate"
                               t-on-change="(ev) => this.editRate('employee_rate', ev)"/>
                        <label class="form-label small mb-0">حصة الشركة %</label>
                        <input type="number" step="0.001" class="form-control form-control-sm"
                               style="width:110px;" t-att-value="state.settings.employer_rate"
                               t-on-change="(ev) => this.editRate('employer_rate', ev)"/>
                    </div>

                    <div t-foreach="state.settings.accounts" t-as="entry" t-key="entry.field"
                         class="o_pr_row">
                        <label class="form-label small mb-0 o_pr_label" t-esc="entry.label"/>
                        <RefPicker value="settingToken(entry)"
                                   options="state.accountOptions"
                                   disabled="state.busy"
                                   placeholder="'اكتب اسم الحساب...'"
                                   onSelect="(token) => this.onSettingAccount(entry, token)"/>
                    </div>
                </div>

                <!-- الكشوف: تبويبات الموظفين، ولكل كشف حسابه وجهة دفعه -->
                <div class="o_pr_bar mt-3">
                    <button class="btn btn-sm btn-primary"
                            t-att-disabled="state.busy or !groupsDirty"
                            t-on-click="() => this.saveGroups()">حفظ الكشوف</button>
                    <button class="btn btn-sm btn-outline-secondary"
                            t-att-disabled="state.busy or !groupsDirty"
                            t-on-click="() => this.cancelGroups()">إلغاء</button>
                    <span t-if="groupsDirty" class="o_pr_dirty">تغييرات لم تُحفظ</span>
                </div>
                <div class="o_pr_panel o_pr_wide">
                    <div class="small text-muted mb-2">
                        الكشوف هي تبويبات الموظفين. ما يُكتب هنا من حساب مصروف أو جهة
                        دفع يرثه كل موظف في الكشف، إلا من كُتب على بطاقته غيره.
                    </div>
                    <table class="table table-bordered table-sm o_pr_table" style="max-width:860px;">
                        <thead>
                            <tr>
                                <th style="width:64px;">ترتيب</th>
                                <th style="width:190px;">الكشف</th>
                                <th style="width:220px;">حساب المصروف</th>
                                <th style="width:220px;">يُدفع من</th>
                                <th style="width:70px;">موظفون</th>
                                <th style="width:44px;"/>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="state.groups" t-as="group" t-key="group._k">
                                <td>
                                    <input type="number" class="form-control form-control-sm"
                                           t-att-value="group.sequence"
                                           t-on-change="(ev) => this.editGroup(group, 'sequence', ev)"/>
                                </td>
                                <td>
                                    <input type="text" class="form-control form-control-sm"
                                           t-att-value="group.name"
                                           t-on-change="(ev) => this.editGroup(group, 'name', ev)"/>
                                </td>
                                <td>
                                    <RefPicker value="groupAccountToken(group)"
                                               options="state.accountOptions"
                                               disabled="state.busy"
                                               placeholder="'حساب الرواتب العام'"
                                               onSelect="(token) => this.onGroupAccount(group, token)"/>
                                </td>
                                <td>
                                    <RefPicker value="groupPaymentToken(group)"
                                               options="state.accountOptions"
                                               disabled="state.busy"
                                               placeholder="'حساب الدفع العام'"
                                               onSelect="(token) => this.onGroupPayment(group, token)"/>
                                </td>
                                <td class="text-center" t-esc="countOf(group.id)"/>
                                <td class="text-center">
                                    <button class="btn btn-sm btn-link text-danger p-0"
                                            title="حذف الكشف"
                                            t-on-click="() => this.removeGroup(group)">
                                        <i class="fa fa-trash"/>
                                    </button>
                                </td>
                            </tr>
                            <tr t-if="!state.groups.length">
                                <td colspan="6" class="text-muted text-center py-2">لا كشوف بعد</td>
                            </tr>
                        </tbody>
                    </table>
                    <button class="btn btn-sm btn-outline-secondary"
                            t-on-click="() => this.addGroup()">
                        <i class="fa fa-plus me-1"/> كشف
                    </button>
                </div>
            </t>
        </div>
    </t>

</templates>
