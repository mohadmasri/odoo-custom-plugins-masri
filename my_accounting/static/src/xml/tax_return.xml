<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="my_accounting.TaxReturn">
        <div class="o_tax_return p-3">

            <div class="d-flex justify-content-between align-items-center mb-3 no-print">
                <h2 class="m-0">الإقرار الضريبي</h2>
                <div class="d-flex gap-2">
                    <button t-attf-class="btn btn-sm {{ state.showColumns ? 'btn-primary' : 'btn-outline-secondary' }}"
                            t-on-click="() => this.toggleColumns()">
                        <i class="fa fa-columns me-1"/> إعدادات الأعمدة
                    </button>
                    <button class="btn btn-secondary btn-sm" t-on-click="() => this.print()">
                        <i class="fa fa-print me-1"/> طباعة
                    </button>
                </div>
            </div>



            <!-- اختيار الفترة -->
            <div class="o_tr_filter no-print">
                <div>
                    <label class="form-label small mb-1">السنة</label>
                    <select class="form-select form-select-sm" style="width:110px;"
                            t-on-change="(ev) => this.onYear(ev)">
                        <option t-foreach="state.years" t-as="y" t-key="y"
                                t-att-value="y" t-att-selected="isYear(y)"
                                t-esc="y"/>
                    </select>
                </div>
                <div>
                    <label class="form-label small mb-1">من شهر</label>
                    <select class="form-select form-select-sm" style="width:150px;"
                            t-on-change="(ev) => this.onMonth('monthFrom', ev)">
                        <option t-foreach="months" t-as="name" t-key="name_index"
                                t-att-value="name_index + 1"
                                t-att-selected="state.monthFrom === name_index + 1">
                            <t t-esc="name_index + 1"/> - <t t-esc="name"/>
                        </option>
                    </select>
                </div>
                <div>
                    <label class="form-label small mb-1">إلى شهر</label>
                    <select class="form-select form-select-sm" style="width:150px;"
                            t-on-change="(ev) => this.onMonth('monthTo', ev)">
                        <option t-foreach="months" t-as="name" t-key="name_index"
                                t-att-value="name_index + 1"
                                t-att-selected="state.monthTo === name_index + 1">
                            <t t-esc="name_index + 1"/> - <t t-esc="name"/>
                        </option>
                    </select>
                </div>
                <div class="o_tr_sep"/>
                <div>
                    <label class="form-label small mb-1 d-block">الفترات المعتادة</label>
                    <div class="btn-group btn-group-sm" role="group">
                        <button t-foreach="pairs" t-as="pair" t-key="pair[0]" type="button"
                                t-attf-class="btn {{ isPair(pair) ? 'btn-primary' : 'btn-outline-secondary' }}"
                                t-on-click="() => this.setPair(pair)">
                            <t t-esc="pair[0] === pair[1] ? pair[0] : pair[0] + ' + ' + pair[1]"/>
                        </button>
                    </div>
                </div>
            </div>

            <div t-if="state.loading" class="text-muted py-5 text-center">يُحسب الإقرار...</div>

            <t t-elif="data">
                <div class="o_tr_head">
                    <h3 class="m-0">إقرار ضريبة المبيعات — <t t-esc="data.period.label"/></h3>
                    <div class="small text-muted">
                        من <t t-esc="data.moves"/> قيد مرحّل · نسبة الضريبة <t t-esc="data.rate"/>%
                        · حساب الضريبة: <t t-esc="data.tax_account"/>
                    </div>
                </div>

                <ul class="nav nav-tabs mt-3 mb-3 no-print">
                    <li class="nav-item">
                        <a href="#" t-attf-class="nav-link {{ state.tab === 'sheets' ? 'active' : '' }}"
                           t-on-click.prevent="() => this.setTab('sheets')">الجداول</a>
                    </li>
                    <li class="nav-item">
                        <a href="#" t-attf-class="nav-link {{ state.tab === 'form' ? 'active' : '' }}"
                           t-on-click.prevent="() => this.setTab('form')">نموذج الدائرة</a>
                    </li>
                </ul>

                <t t-if="state.tab === 'sheets'">
                <!-- جداول الإقرار: تُبنى من القيود ثم تُحرَّر -->
                <div class="o_tr_sheet_bar">
                    <button class="btn btn-sm btn-primary" t-att-disabled="state.busy"
                            t-on-click="() => this.build(true)">
                        <i class="fa fa-refresh me-1"/> أضف ما استجدّ من القيود
                    </button>
                    <button class="btn btn-sm btn-outline-danger" t-att-disabled="state.busy"
                            t-on-click="() => this.rebuild()">إعادة بناء الكشف</button>
                    <span class="small text-muted">
                        الجداول لك: عدّل أي خانة، وأضف صفوفاً أو احذفها.
                    </span>
                </div>

                <div t-foreach="sheet.tables" t-as="table" t-key="table.key" class="o_tr_sheet">
                    <h4 class="o_tr_section_title"><t t-esc="table.label"/></h4>

                    <!-- أعمدة هذا الجدول وحده: اسمها وترتيبها -->
                    <div t-if="state.showColumns" class="o_tr_cols no-print">
                        <div class="small text-muted mb-2">
                            أعمدة <b t-esc="table.label"/>: غيّر اسم العمود أو اسحبه إلى مكانه.
                            ما تغيّره هنا يسري على هذا الجدول في
                            <b>كل الإقرارات</b> — السابقة والقادمة — <b>وعلى الطباعة</b>.
                        </div>
                        <div class="o_tr_cols_list">
                            <div t-foreach="columnsFor(table.key)" t-as="column"
                                 t-key="column.key + '|' + column.label"
                                 t-attf-class="o_tr_cols_row {{ isDragging(table.key, column_index) ? 'o_tr_cols_drag' : '' }}"
                                 draggable="true"
                                 t-on-dragstart="(ev) => this.onColumnDragStart(table.key, column_index, ev)"
                                 t-on-dragover="(ev) => this.onColumnDragOver(table.key, column_index, ev)"
                                 t-on-dragend="() => this.onColumnDragEnd(table.key)">
                                <span class="o_tr_cols_handle" title="اسحب لتغيير الترتيب">
                                    <i class="fa fa-bars"/>
                                </span>
                                <span class="o_tr_cols_pos" t-esc="column_index + 1"/>
                                <input type="text" class="form-control form-control-sm o_tr_cols_name"
                                       t-att-value="column.label"
                                       t-on-change="(ev) => this.onColumnLabel(table.key, column, ev)"/>
                            </div>
                        </div>
                        <div class="o_tr_cols_sort">
                            <span class="o_tr_cols_sortlabel">رتّب صفوف الجدول حسب</span>
                            <select class="form-select form-select-sm" style="width:150px;"
                                    t-on-change="(ev) => this.onSortColumn(table.key, ev)">
                                <option value="">ترتيب البناء</option>
                                <option t-foreach="columnsFor(table.key)" t-as="col"
                                        t-key="col.key" t-att-value="col.key"
                                        t-att-selected="isSortColumn(table.key, col.key)"
                                        t-esc="col.label"/>
                            </select>
                            <div class="btn-group btn-group-sm">
                                <button t-attf-class="btn {{ hasSort(table.key) and !sortOf(table.key).descending ? 'btn-primary' : 'btn-outline-secondary' }}"
                                        t-att-disabled="!hasSort(table.key)"
                                        t-on-click="() => this.setSortDirection(table.key, false)">
                                    تصاعدي
                                </button>
                                <button t-attf-class="btn {{ sortOf(table.key).descending ? 'btn-primary' : 'btn-outline-secondary' }}"
                                        t-att-disabled="!hasSort(table.key)"
                                        t-on-click="() => this.setSortDirection(table.key, true)">
                                    تنازلي
                                </button>
                            </div>
                        </div>

                        <button class="btn btn-sm btn-outline-secondary mt-2"
                                t-att-disabled="state.savingColumns"
                                t-on-click="() => this.resetColumns(table.key)">
                            أسماء وترتيب هذا الجدول الأصلية
                        </button>
                    </div>

                    <table class="table table-bordered table-sm o_tr_table">
                        <thead>
                            <tr>
                                <th class="o_tr_c_mark"/>
                                <!-- رابط القيد في المبيعات: أول الجدول -->
                                <th t-if="!isPurchase(table.key)" class="o_tr_link"/>
                                <th t-foreach="columnsFor(table.key)" t-as="col" t-key="col.key"
                                    t-attf-class="o_tr_c_{{ col.key }} {{ isNumberColumn(col) ? 'text-end' : '' }}"
                                    t-esc="col.label"/>
                                <!-- رابط القيد في المشتريات: آخر الجدول -->
                                <th t-if="isPurchase(table.key)" class="o_tr_link"/>
                                <th class="o_tr_del"/>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="rowsOf(table.key)" t-as="row" t-key="row.id">
                                <td class="o_tr_mark">
                                    <sup t-if="row.marks.length" class="text-danger"
                                         t-att-title="'له مرتجع بالمستند ' + row.marks.join('، ')">
                                        *<t t-esc="row.marks.join(',')"/>
                                    </sup>
                                    <sup t-if="row.return_of" class="text-muted"
                                         t-att-title="'مرتجع عن المستند ' + row.return_of">
                                        ←<t t-esc="row.return_of"/>
                                    </sup>
                                </td>
                                <td t-if="!isPurchase(table.key)" class="o_tr_link">
                                    <a t-if="row.move_id" href="#" title="افتح القيد"
                                       t-custom-click="(ev, mid) => this.openMove(row.move_id, mid)">
                                        <i class="fa fa-external-link"/>
                                    </a>
                                </td>
                                <t t-foreach="columnsFor(table.key)" t-as="col" t-key="col.key">
                                    <!-- كل خانة: حقل للشاشة ونصّ للطباعة، فالحقل
                                         لا يلتفّ ويقصّ ما لا يسعه -->
                                    <td t-if="col.key === 'date'">
                                        <input type="date" class="form-control form-control-sm o_tr_in"
                                               t-att-value="row.date"
                                               t-on-change="(ev) => this.saveCell(row, 'date', ev)"/>
                                        <span class="o_tr_out" t-esc="fmtDate(row.date)"/>
                                    </td>
                                    <td t-elif="isNumberColumn(col)" class="text-end">
                                        <input type="number" step="0.001"
                                               class="form-control form-control-sm text-end o_tr_in"
                                               t-att-value="cellValue(row, col)"
                                               t-on-change="(ev) => this.saveCell(row, cellField(col), ev)"/>
                                        <span class="o_tr_out" t-esc="fmt(cellValue(row, col))"/>
                                    </td>
                                    <td t-else=""
                                        t-attf-class="{{ col.key === 'party' ? 'o_tr_party' : '' }}">
                                        <input type="text"
                                               class="form-control form-control-sm o_tr_in"
                                               t-att-value="cellValue(row, col)"
                                               t-on-change="(ev) => this.saveCell(row, cellField(col), ev)"/>
                                        <span class="o_tr_out" t-esc="cellValue(row, col)"/>
                                    </td>
                                </t>
                                <td t-if="isPurchase(table.key)" class="o_tr_link">
                                    <a t-if="row.move_id" href="#" title="افتح القيد"
                                       t-custom-click="(ev, mid) => this.openMove(row.move_id, mid)">
                                        <i class="fa fa-external-link"/>
                                    </a>
                                </td>
                                <td class="text-center o_tr_del">
                                    <button class="btn btn-sm btn-link text-danger p-0" title="حذف السطر"
                                            t-on-click="() => this.deleteRow(row)">
                                        <i class="fa fa-trash"/>
                                    </button>
                                </td>
                            </tr>
                            <tr t-if="!rowsOf(table.key).length">
                                <td t-att-colspan="spanOf(table.key)"
                                    class="text-muted text-center py-2">لا صفوف</td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr class="fw-bold">
                                <td/>
                                <td t-if="!isPurchase(table.key)" class="o_tr_link"/>
                                <t t-foreach="columnsFor(table.key)" t-as="col" t-key="col.key">
                                    <td t-if="isNumberColumn(col)" class="text-end"
                                        t-esc="fmt(totalOf(table.key, cellField(col)))"/>
                                    <td t-elif="col.key === totalLabelKey(table.key)"
                                        class="text-end">المجموع</td>
                                    <td t-else=""/>
                                </t>
                                <td t-if="isPurchase(table.key)" class="o_tr_link"/>
                                <td class="o_tr_del"/>
                            </tr>
                        </tfoot>
                    </table>
                    <button class="btn btn-sm btn-outline-secondary no-print"
                            t-on-click="() => this.addRow(table.key)">
                        <i class="fa fa-plus me-1"/> صف
                    </button>
                </div>

                <table class="table table-bordered table-sm o_tr_summary mt-4">
                    <tbody>
                        <tr>
                            <td>ضريبة المبيعات (بعد المرتجعات)</td>
                            <td class="text-end"
                                t-esc="fmt(totalOf('sale', 'tax') - totalOf('sale_return', 'tax'))"/>
                        </tr>
                        <tr>
                            <td>ناقص: ضريبة المشتريات (بعد المرتجعات)</td>
                            <td class="text-end"
                                t-esc="'(' + fmt(totalOf('purchase', 'tax') - totalOf('purchase_return', 'tax')) + ')'"/>
                        </tr>
                        <tr class="o_tr_due">
                            <td>المستحق للفترة</td>
                            <td class="text-end" t-esc="fmt(sheetDue)"/>
                        </tr>
                    </tbody>
                </table>

                <!-- مجاميع القيم، لا الضريبة -->
                <table class="table table-bordered table-sm o_tr_summary mt-4">
                    <tbody>
                        <tr>
                            <td>مجموع المشتريات بعد خصم المرتجع</td>
                            <td class="text-end" t-esc="fmt(netAmount('purchase'))"/>
                        </tr>
                        <tr>
                            <td>مجموع المبيعات بعد خصم المرتجع</td>
                            <td class="text-end" t-esc="fmt(netAmount('sale'))"/>
                        </tr>
                        <tr>
                            <td>مجموع المبيعات الصفرية/معفاة بعد خصم المرتجع</td>
                            <td class="text-end" t-esc="fmt(exemptSales)"/>
                        </tr>
                    </tbody>
                </table>
                </t>

                <!-- نموذج الدائرة: خاناته محسوبة من الجداول -->
                <t t-if="state.tab === 'form'">
                    <table class="table table-bordered table-sm o_tr_form">
                        <thead>
                            <tr>
                                <th style="width:48px;">الرقم</th>
                                <th>البيــان</th>
                                <th class="text-end" style="width:150px;">القيمــة</th>
                                <th class="text-end" style="width:150px;">الضريبة العامة</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>1</td>
                                <td>الرصيد المدور من الفترة السابقة</td>
                                <td class="text-end o_tr_blank">—</td>
                                <td class="text-end o_tr_blank">—</td>
                            </tr>
                            <tr>
                                <td>2</td>
                                <td>المشتريات المحلية الخاضعة للضريبة بالنسبة العامة</td>
                                <td class="text-end" t-esc="fmt(form.purchase)"/>
                                <td class="text-end" t-esc="fmt(form.purchaseTax)"/>
                            </tr>
                            <tr>
                                <td>3</td>
                                <td>المستوردات الخاضعة للضريبة بالنسبة العامة</td>
                                <td class="text-end" t-esc="fmt(0)"/>
                                <td class="text-end" t-esc="fmt(0)"/>
                            </tr>
                            <tr>
                                <td>4</td>
                                <td>المستوردات مؤجلة توريد الضريبة</td>
                                <td class="text-end" t-esc="fmt(0)"/>
                                <td class="text-end" t-esc="fmt(0)"/>
                            </tr>
                            <tr>
                                <td>5</td>
                                <td>المشتريات والمستوردات المعفاة</td>
                                <td class="text-end o_tr_blank">—</td>
                                <td class="text-end o_tr_blank">—</td>
                            </tr>
                            <tr>
                                <td rowspan="3">6</td>
                                <td>المبيعات المحلية الخاضعة للضريبة بالنسبة العامة 16%</td>
                                <td class="text-end" t-esc="fmt(form.sales)"/>
                                <td class="text-end" t-esc="fmt(form.salesTax)"/>
                            </tr>
                            <tr>
                                <td>المبيعات المحلية الخاضعة للضريبة بالنسبة العامة 8%</td>
                                <td class="text-end" t-esc="fmt(0)"/>
                                <td class="text-end" t-esc="fmt(0)"/>
                            </tr>
                            <tr>
                                <td>المبيعات المحلية الخاضعة للضريبة بالنسبة العامة 4%</td>
                                <td class="text-end" t-esc="fmt(0)"/>
                                <td class="text-end" t-esc="fmt(0)"/>
                            </tr>
                            <tr>
                                <td>7</td>
                                <td>المبيعات المحلية الخاضعة للضريبة لنسبة الصفر</td>
                                <td class="text-end" t-esc="fmt(0)"/>
                                <td class="text-end" t-esc="fmt(0)"/>
                            </tr>
                            <tr>
                                <td>8</td>
                                <td>المبيعات المصدرة</td>
                                <td class="text-end" t-esc="fmt(0)"/>
                                <td class="text-end" t-esc="fmt(0)"/>
                            </tr>
                            <tr>
                                <td>9</td>
                                <td>مبيعات غير خاضعة للضريبة</td>
                                <td class="text-end" t-esc="fmt(0)"/>
                                <td class="text-end" t-esc="fmt(0)"/>
                            </tr>
                            <tr>
                                <td>10</td>
                                <td>المبيعات المحلية المعفاة</td>
                                <td class="text-end" t-esc="fmt(form.exempt)"/>
                                <td class="text-end o_tr_blank">—</td>
                            </tr>
                            <tr>
                                <td>11</td>
                                <td>ضريبة غير قابلة للخصم (تخص سلع مبيعات معفاة)</td>
                                <td class="text-end o_tr_blank">—</td>
                                <td class="text-end" t-esc="fmt(form.blocked)"/>
                            </tr>
                            <tr>
                                <td>12</td>
                                <td>حركة تعديل لصالح المسجل</td>
                                <td class="text-end o_tr_blank">—</td>
                                <td class="text-end" t-esc="fmt(0)"/>
                            </tr>
                            <tr>
                                <td>13</td>
                                <td>حركة تعديل لصالح الدائرة</td>
                                <td class="text-end o_tr_blank">—</td>
                                <td class="text-end" t-esc="fmt(0)"/>
                            </tr>
                            <tr class="o_tr_due">
                                <td>14</td>
                                <td>ضريبة الخانات (6 + 11 + 13) − (1 + 2 + 3 + 4 + 12)
                                    موجباً: مبلغ واجب دفعه</td>
                                <td class="text-end o_tr_blank">—</td>
                                <td class="text-end" t-esc="fmt(form.due)"/>
                            </tr>
                            <tr>
                                <td>15</td>
                                <td>الخانات نفسها سالباً: عبء الخانات من (16 − 18)</td>
                                <td class="text-end o_tr_blank">—</td>
                                <td class="text-end" t-esc="fmt(form.credit)"/>
                            </tr>
                            <tr>
                                <td>16</td>
                                <td>استرداد الضريبة على السلع والخدمات المصدرة</td>
                                <td class="text-end o_tr_blank">—</td>
                                <td class="text-end" t-esc="fmt(0)"/>
                            </tr>
                            <tr>
                                <td>17</td>
                                <td>استرداد ضريبة مضى على تأديتها أكثر من سنة</td>
                                <td class="text-end o_tr_blank">—</td>
                                <td class="text-end" t-esc="fmt(0)"/>
                            </tr>
                            <tr>
                                <td>18</td>
                                <td>الرصيد المدور للفترة القادمة: 15 − (16 + 17)</td>
                                <td class="text-end o_tr_blank">—</td>
                                <td class="text-end" t-esc="fmt(0)"/>
                            </tr>
                        </tbody>
                    </table>

                    <div class="o_tr_form_notes">
                        <div>
                            <b>الخانة 2</b> و<b>الخانة 6</b> و<b>الخانة 10</b> بعد خصم مرتجعاتها،
                            لأن النموذج لا سطر فيه للمرتجع.
                        </div>
                        <div>
                            <b>الخانة 11</b> = ضريبة المشتريات × (المبيعات المعفاة ÷ مجموع المبيعات)
                            = <t t-esc="fmt(form.purchaseTax)"/> ×
                            (<t t-esc="fmt(form.exempt)"/> ÷ <t t-esc="fmt(form.base)"/>)
                            = <t t-esc="fmt(form.purchaseTax)"/> × <t t-esc="form.share"/>%
                            = <t t-esc="fmt(form.blocked)"/>
                        </div>
                        <div>
                            <b>الخانة 1</b> (الرصيد المدور من الفترة السابقة) و<b>الخانة 5</b>
                            (المشتريات المعفاة) ليستا في جداول الإقرار، فتُكتبان باليد إن وُجدتا.
                        </div>
                    </div>
                </t>
            </t>
        </div>
    </t>

    <!-- جدول قسم واحد من أقسام الإقرار -->
    <t t-name="my_accounting.TaxReturnSection">
        <div t-if="rows.length" class="o_tr_section">
            <h4 class="o_tr_section_title"><t t-esc="title"/></h4>
            <table class="table table-bordered table-sm">
                <thead>
                    <tr>
                        <th style="width:90px;">القيد</th>
                        <th style="width:110px;">التاريخ</th>
                        <th>البيان</th>
                        <th t-if="withReason">السبب</th>
                        <th t-if="withBase" class="text-end" style="width:130px;">الأساس</th>
                        <th t-if="!hideTax" class="text-end" style="width:130px;">الضريبة</th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="rows" t-as="row" t-key="row_index"
                        style="cursor:pointer;"
                        t-custom-click="(ev, isMiddleClick) => this.openMove(row.move_id, isMiddleClick)">
                        <td><strong t-esc="row.move"/></td>
                        <td t-esc="row.date"/>
                        <td>
                            <t t-esc="row.label"/>
                            <span t-if="row.estimated" class="badge text-bg-secondary ms-1"
                                  title="لا يوجد بند مقابل بنفس البيان، فقُدِّر الأساس من النسبة">مُقدَّر</span>
                        </td>
                        <td t-if="withReason" class="text-muted small" t-esc="row.reason"/>
                        <td t-if="withBase" class="text-end" t-esc="fmt(row.base)"/>
                        <td t-if="!hideTax" class="text-end" t-esc="fmt(row.tax)"/>
                    </tr>
                </tbody>
                <tfoot>
                    <tr class="fw-bold">
                        <td t-att-colspan="withReason ? 4 : 3" class="text-end">المجموع</td>
                        <td t-if="withBase" class="text-end"
                            t-esc="fmt(sectionTotal(rows, 'base'))"/>
                        <td t-if="!hideTax" class="text-end"
                            t-esc="fmt(sectionTotal(rows, 'tax'))"/>
                    </tr>
                </tfoot>
            </table>
        </div>
    </t>

</templates>
