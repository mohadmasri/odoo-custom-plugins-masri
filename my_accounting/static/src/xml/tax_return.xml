<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="my_accounting.TaxReturn">
        <div class="o_tax_return p-3">

            <div class="d-flex justify-content-between align-items-center mb-3 no-print">
                <h2 class="m-0">الإقرار الضريبي</h2>
                <button class="btn btn-secondary btn-sm" t-on-click="() => this.print()">
                    <i class="fa fa-print me-1"/> طباعة
                </button>
            </div>

            <!-- اختيار الفترة -->
            <div class="o_tr_filter no-print">
                <div>
                    <label class="form-label small mb-1">السنة</label>
                    <select class="form-select form-select-sm" style="width:110px;"
                            t-on-change="(ev) => this.onYear(ev)">
                        <option t-foreach="state.years" t-as="y" t-key="y"
                                t-att-value="y" t-att-selected="isYear(y)"
                                t-esc="y"/>
                    </select>
                </div>
                <div>
                    <label class="form-label small mb-1">من شهر</label>
                    <select class="form-select form-select-sm" style="width:150px;"
                            t-on-change="(ev) => this.onMonth('monthFrom', ev)">
                        <option t-foreach="months" t-as="name" t-key="name_index"
                                t-att-value="name_index + 1"
                                t-att-selected="state.monthFrom === name_index + 1">
                            <t t-esc="name_index + 1"/> - <t t-esc="name"/>
                        </option>
                    </select>
                </div>
                <div>
                    <label class="form-label small mb-1">إلى شهر</label>
                    <select class="form-select form-select-sm" style="width:150px;"
                            t-on-change="(ev) => this.onMonth('monthTo', ev)">
                        <option t-foreach="months" t-as="name" t-key="name_index"
                                t-att-value="name_index + 1"
                                t-att-selected="state.monthTo === name_index + 1">
                            <t t-esc="name_index + 1"/> - <t t-esc="name"/>
                        </option>
                    </select>
                </div>
                <div class="o_tr_sep"/>
                <div>
                    <label class="form-label small mb-1 d-block">الفترات المعتادة</label>
                    <div class="btn-group btn-group-sm" role="group">
                        <button t-foreach="pairs" t-as="pair" t-key="pair[0]" type="button"
                                t-attf-class="btn {{ isPair(pair) ? 'btn-primary' : 'btn-outline-secondary' }}"
                                t-on-click="() => this.setPair(pair)">
                            <t t-esc="pair[0] === pair[1] ? pair[0] : pair[0] + ' + ' + pair[1]"/>
                        </button>
                    </div>
                </div>
            </div>

            <div t-if="state.loading" class="text-muted py-5 text-center">يُحسب الإقرار...</div>

            <t t-elif="data">
                <div class="o_tr_head">
                    <h3 class="m-0">إقرار ضريبة المبيعات — <t t-esc="data.period.label"/></h3>
                    <div class="small text-muted">
                        من <t t-esc="data.moves"/> قيد مرحّل · نسبة الضريبة <t t-esc="data.rate"/>%
                        · حساب الضريبة: <t t-esc="data.tax_account"/>
                    </div>
                </div>

                <!-- جداول الإقرار: تُبنى من القيود ثم تُحرَّر -->
                <div class="o_tr_sheet_bar">
                    <button class="btn btn-sm btn-primary" t-att-disabled="state.busy"
                            t-on-click="() => this.build(true)">
                        <i class="fa fa-refresh me-1"/> أضف ما استجدّ من القيود
                    </button>
                    <button class="btn btn-sm btn-outline-danger" t-att-disabled="state.busy"
                            t-on-click="() => this.rebuild()">إعادة بناء الكشف</button>
                    <span class="small text-muted">
                        الجداول لك: عدّل أي خانة، وأضف صفوفاً أو احذفها.
                    </span>
                </div>

                <div t-foreach="sheet.tables" t-as="table" t-key="table.key" class="o_tr_sheet">
                    <h4 class="o_tr_section_title"><t t-esc="table.label"/></h4>
                    <table class="table table-bordered table-sm o_tr_table">
                        <thead>
                            <tr>
                                <th style="width:34px;"/>
                                <th t-if="isPurchase(table.key)" style="width:120px;">الرقم الضريبي</th>
                                <!-- رابط القيد: قبل رقم السند في المبيعات -->
                                <th t-if="!isPurchase(table.key)" style="width:34px;"/>
                                <th style="width:110px;">
                                    <t t-if="isPurchase(table.key)">رقم الفاتورة</t>
                                    <t t-else="">رقم السند</t>
                                </th>
                                <th t-if="!isPurchase(table.key)" style="width:90px;">نوعه</th>
                                <th style="width:125px;">التاريخ</th>
                                <!-- البيان يأخذ ما بقي من عرض الجدول -->
                                <th style="width:100%; min-width:220px;">البيان</th>
                                <th class="text-end" style="width:120px;">القيمة</th>
                                <th class="text-end" style="width:110px;">الضريبة</th>
                                <th t-if="isPurchase(table.key)" style="width:100px;">سند القيد</th>
                                <!-- رابط القيد: بجانب عمود سند القيد في المشتريات -->
                                <th t-if="isPurchase(table.key)" style="width:34px;"/>
                                <th style="width:34px;"/>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="rowsOf(table.key)" t-as="row" t-key="row.id">
                                <td class="o_tr_mark">
                                    <sup t-if="row.marks.length" class="text-danger"
                                         t-att-title="'له مرتجع بالمستند ' + row.marks.join('، ')">
                                        *<t t-esc="row.marks.join(',')"/>
                                    </sup>
                                    <sup t-if="row.return_of" class="text-muted"
                                         t-att-title="'مرتجع عن المستند ' + row.return_of">
                                        ←<t t-esc="row.return_of"/>
                                    </sup>
                                </td>
                                <td t-if="isPurchase(table.key)">
                                    <input type="text" class="form-control form-control-sm"
                                           t-att-value="row.tax_number"
                                           t-on-change="(ev) => this.saveCell(row, 'tax_number', ev)"/>
                                </td>
                                <td t-if="!isPurchase(table.key)" class="o_tr_link">
                                    <a t-if="row.move_id" href="#" title="افتح القيد"
                                       t-custom-click="(ev, mid) => this.openMove(row.move_id, mid)">
                                        <i class="fa fa-external-link"/>
                                    </a>
                                </td>
                                <td>
                                    <input type="text" class="form-control form-control-sm"
                                           t-att-value="row.doc_number"
                                           t-on-change="(ev) => this.saveCell(row, 'doc_number', ev)"/>
                                </td>
                                <td t-if="!isPurchase(table.key)">
                                    <input type="text" class="form-control form-control-sm"
                                           t-att-value="row.doc_type"
                                           t-on-change="(ev) => this.saveCell(row, 'doc_type', ev)"/>
                                </td>
                                <td>
                                    <input type="date" class="form-control form-control-sm"
                                           t-att-value="row.date"
                                           t-on-change="(ev) => this.saveCell(row, 'date', ev)"/>
                                </td>
                                <td>
                                    <input type="text" class="form-control form-control-sm"
                                           t-att-value="row.label"
                                           t-on-change="(ev) => this.saveCell(row, 'label', ev)"/>
                                </td>
                                <td>
                                    <input type="number" step="0.001"
                                           class="form-control form-control-sm text-end"
                                           t-att-value="row.amount"
                                           t-on-change="(ev) => this.saveCell(row, 'amount', ev)"/>
                                </td>
                                <td>
                                    <input type="number" step="0.001"
                                           class="form-control form-control-sm text-end"
                                           t-att-value="row.tax"
                                           t-on-change="(ev) => this.saveCell(row, 'tax', ev)"/>
                                </td>
                                <td t-if="isPurchase(table.key)">
                                    <input type="text" class="form-control form-control-sm"
                                           t-att-value="row.move_name"
                                           t-on-change="(ev) => this.saveCell(row, 'move_name', ev)"/>
                                </td>
                                <td t-if="isPurchase(table.key)" class="o_tr_link">
                                    <a t-if="row.move_id" href="#" title="افتح القيد"
                                       t-custom-click="(ev, mid) => this.openMove(row.move_id, mid)">
                                        <i class="fa fa-external-link"/>
                                    </a>
                                </td>
                                <td class="text-center">
                                    <button class="btn btn-sm btn-link text-danger p-0" title="حذف السطر"
                                            t-on-click="() => this.deleteRow(row)">
                                        <i class="fa fa-trash"/>
                                    </button>
                                </td>
                            </tr>
                            <tr t-if="!rowsOf(table.key).length">
                                <td t-att-colspan="isPurchase(table.key) ? 10 : 9"
                                    class="text-muted text-center py-2">لا صفوف</td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr class="fw-bold">
                                <td t-att-colspan="isPurchase(table.key) ? 5 : 6"
                                    class="text-end">المجموع</td>
                                <td class="text-end" t-esc="fmt(totalOf(table.key, 'amount'))"/>
                                <td class="text-end" t-esc="fmt(totalOf(table.key, 'tax'))"/>
                                <td t-if="isPurchase(table.key)"/>
                                <td t-if="isPurchase(table.key)"/>
                                <td/>
                            </tr>
                        </tfoot>
                    </table>
                    <button class="btn btn-sm btn-outline-secondary no-print"
                            t-on-click="() => this.addRow(table.key)">
                        <i class="fa fa-plus me-1"/> صف
                    </button>
                </div>

                <table class="table table-bordered table-sm o_tr_summary mt-4">
                    <tbody>
                        <tr>
                            <td>ضريبة المبيعات (بعد المرتجعات)</td>
                            <td class="text-end"
                                t-esc="fmt(totalOf('sale', 'tax') - totalOf('sale_return', 'tax'))"/>
                        </tr>
                        <tr>
                            <td>ناقص: ضريبة المشتريات (بعد المرتجعات)</td>
                            <td class="text-end"
                                t-esc="'(' + fmt(totalOf('purchase', 'tax') - totalOf('purchase_return', 'tax')) + ')'"/>
                        </tr>
                        <tr class="o_tr_due">
                            <td>المستحق للفترة</td>
                            <td class="text-end" t-esc="fmt(sheetDue)"/>
                        </tr>
                    </tbody>
                </table>
            </t>
        </div>
    </t>

    <!-- جدول قسم واحد من أقسام الإقرار -->
    <t t-name="my_accounting.TaxReturnSection">
        <div t-if="rows.length" class="o_tr_section">
            <h4 class="o_tr_section_title"><t t-esc="title"/></h4>
            <table class="table table-bordered table-sm">
                <thead>
                    <tr>
                        <th style="width:90px;">القيد</th>
                        <th style="width:110px;">التاريخ</th>
                        <th>البيان</th>
                        <th t-if="withReason">السبب</th>
                        <th t-if="withBase" class="text-end" style="width:130px;">الأساس</th>
                        <th t-if="!hideTax" class="text-end" style="width:130px;">الضريبة</th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="rows" t-as="row" t-key="row_index"
                        style="cursor:pointer;"
                        t-custom-click="(ev, isMiddleClick) => this.openMove(row.move_id, isMiddleClick)">
                        <td><strong t-esc="row.move"/></td>
                        <td t-esc="row.date"/>
                        <td>
                            <t t-esc="row.label"/>
                            <span t-if="row.estimated" class="badge text-bg-secondary ms-1"
                                  title="لا يوجد بند مقابل بنفس البيان، فقُدِّر الأساس من النسبة">مُقدَّر</span>
                        </td>
                        <td t-if="withReason" class="text-muted small" t-esc="row.reason"/>
                        <td t-if="withBase" class="text-end" t-esc="fmt(row.base)"/>
                        <td t-if="!hideTax" class="text-end" t-esc="fmt(row.tax)"/>
                    </tr>
                </tbody>
                <tfoot>
                    <tr class="fw-bold">
                        <td t-att-colspan="withReason ? 4 : 3" class="text-end">المجموع</td>
                        <td t-if="withBase" class="text-end"
                            t-esc="fmt(sectionTotal(rows, 'base'))"/>
                        <td t-if="!hideTax" class="text-end"
                            t-esc="fmt(sectionTotal(rows, 'tax'))"/>
                    </tr>
                </tfoot>
            </table>
        </div>
    </t>

</templates>
