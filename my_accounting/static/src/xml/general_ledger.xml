<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="my_accounting.GeneralLedger">
        <div class="o_general_ledger p-3" style="overflow:auto; height:100%;">
            <div class="d-flex justify-content-between align-items-center mb-3 no-print">
                <h2 class="m-0">دفتر الأستاذ العام</h2>
                <div class="d-flex align-items-center" style="gap: 8px;">
                    <button class="btn btn-outline-secondary btn-sm" t-on-click="() => this.shiftMonth(-1)">
                        <i class="fa fa-chevron-right"/>
                    </button>
                    <input type="month" class="form-control form-control-sm" style="width:160px;"
                           t-att-value="state.month" t-on-change="(ev) => this.onMonthChange(ev)"/>
                    <button class="btn btn-outline-secondary btn-sm" t-on-click="() => this.shiftMonth(1)">
                        <i class="fa fa-chevron-left"/>
                    </button>
                    <button class="btn btn-secondary" t-on-click="() => this.printLedger()">
                        <i class="fa fa-print me-1"/> طباعة
                    </button>
                    <button class="btn btn-success" t-on-click="() => this.exportExcel()">
                        <i class="fa fa-file-excel-o me-1"/> تحميل Excel
                    </button>
                </div>
            </div>

            <div t-if="state.loading" class="text-center text-muted py-5">جارِ التحميل...</div>

            <t t-if="!state.loading and state.data">
                <h4 class="mb-3" t-esc="state.month"/>

                <div t-if="!state.data.rows.length" class="text-center text-muted py-5">
                    لا توجد قيود مرحّلة خلال هذا الشهر
                </div>

                <div t-if="state.data.rows.length" style="overflow-x:auto;">
                    <table class="table table-bordered table-sm" style="white-space:nowrap;">
                        <thead>
                            <tr>
                                <th rowspan="2">#</th>
                                <th rowspan="2">القيد</th>
                                <th rowspan="2">التاريخ</th>
                                <th rowspan="2">المرجع</th>
                                <th rowspan="2" class="text-end">إجمالي مدين</th>
                                <th rowspan="2" class="text-end">إجمالي دائن</th>
                                <t t-foreach="state.data.accounts" t-as="acc" t-key="acc.id">
                                    <th colspan="2" class="text-center">
                                        <t t-esc="acc.code"/><t t-esc="' - '"/><t t-esc="acc.name"/>
                                    </th>
                                </t>
                            </tr>
                            <tr>
                                <t t-foreach="state.data.accounts" t-as="acc" t-key="acc.id">
                                    <th class="text-end small">من</th>
                                    <th class="text-end small">إلى</th>
                                </t>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="state.data.rows" t-as="row" t-key="row.move_id"
                                style="cursor:pointer;" t-on-click="() => this.openMove(row.move_id)">
                                <td t-esc="row.seq"/>
                                <td><strong t-esc="row.move_name"/></td>
                                <td t-esc="row.date"/>
                                <td t-esc="row.ref"/>
                                <td class="text-end" t-esc="this.fmt(row.total_debit)"/>
                                <td class="text-end" t-esc="this.fmt(row.total_credit)"/>
                                <t t-foreach="state.data.accounts" t-as="acc" t-key="acc.id">
                                    <td class="text-end" t-esc="row.amounts[acc.id] ? this.fmt(row.amounts[acc.id].debit) : ''"/>
                                    <td class="text-end" t-esc="row.amounts[acc.id] ? this.fmt(row.amounts[acc.id].credit) : ''"/>
                                </t>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr class="fw-bold">
                                <td colspan="4" class="text-end">الإجمالي</td>
                                <td class="text-end" t-esc="this.fmt(state.data.grand_debit)"/>
                                <td class="text-end" t-esc="this.fmt(state.data.grand_credit)"/>
                                <t t-foreach="state.data.accounts" t-as="acc" t-key="acc.id">
                                    <td class="text-end" t-esc="state.data.totals[acc.id] ? this.fmt(state.data.totals[acc.id].debit) : ''"/>
                                    <td class="text-end" t-esc="state.data.totals[acc.id] ? this.fmt(state.data.totals[acc.id].credit) : ''"/>
                                </t>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </t>
        </div>
    </t>

</templates>
