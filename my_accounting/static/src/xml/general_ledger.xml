<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="my_accounting.GeneralLedger">
        <div class="o_general_ledger p-3" style="overflow:auto; height:100%;">
            <div class="d-flex justify-content-between align-items-center mb-3 no-print">
                <h2 class="m-0">دفتر الأستاذ العام</h2>
                <div class="d-flex align-items-center" style="gap: 8px;">
                    <button class="btn btn-outline-secondary btn-sm" t-on-click="() => this.shiftMonth(-1)">
                        <i class="fa fa-chevron-right"/>
                    </button>
                    <input type="month" class="form-control form-control-sm" style="width:160px;"
                           t-att-value="state.month" t-on-change="(ev) => this.onMonthChange(ev)"/>
                    <button class="btn btn-outline-secondary btn-sm" t-on-click="() => this.shiftMonth(1)">
                        <i class="fa fa-chevron-left"/>
                    </button>
                    <div class="btn-group btn-group-sm" role="group">
                        <t t-foreach="stateFilters" t-as="flt" t-key="flt.value">
                            <button type="button"
                                    t-attf-class="btn {{ isStateActive(flt.value) ? 'btn-primary' : 'btn-outline-secondary' }}"
                                    t-on-click="() => this.onStateFilter(flt.value)"
                                    t-esc="flt.label"/>
                        </t>
                    </div>
                    <button class="btn btn-secondary" t-on-click="() => this.printLedger()">
                        <i class="fa fa-print me-1"/> طباعة
                    </button>
                    <button class="btn btn-success" t-on-click="() => this.exportExcel()">
                        <i class="fa fa-file-excel-o me-1"/> تحميل Excel
                    </button>
                </div>
            </div>

            <div class="no-print">
                    <PeriodFilter year="filterYear" month="filterMonth" onChange.bind="onPeriodChange"/>
                </div>

            <div t-if="state.loading" class="text-center text-muted py-5">جارِ التحميل...</div>

            <t t-if="!state.loading and state.data">
                <h4 class="mb-3 o_gl_title" t-esc="state.month"/>

                <div t-if="!state.data.rows.length" class="text-center text-muted py-5">
                    لا توجد قيود بالحالات المختارة خلال هذا الشهر
                </div>

                <div t-if="state.data.rows.length" class="o_gl_printable" style="overflow-x:auto;">
                    <table class="table table-bordered table-sm o_gl_table" style="white-space:nowrap;">
                        <!-- عرض ثابت لكل عمود: أعمدة الأرقام متساوية دائماً حتى لو كانت فارغة -->
                        <colgroup>
                            <col class="o_gl_col_seq"/>
                            <col class="o_gl_col_move"/>
                            <col class="o_gl_col_date"/>
                            <col class="o_gl_col_ref"/>
                            <col class="o_gl_col_num"/>
                            <col class="o_gl_col_num"/>
                            <t t-foreach="state.data.accounts" t-as="acc" t-key="acc.id">
                                <col class="o_gl_col_num"/>
                                <col class="o_gl_col_num"/>
                            </t>
                        </colgroup>
                        <thead>
                            <tr>
                                <th rowspan="2" class="o_gl_seq">#</th>
                                <th rowspan="2" class="o_gl_move">القيد</th>
                                <th rowspan="2" class="o_gl_date">التاريخ</th>
                                <th rowspan="2" class="o_gl_ref">المرجع</th>
                                <th rowspan="2" class="text-end o_gl_num">إجمالي مدين</th>
                                <th rowspan="2" class="text-end o_gl_num">إجمالي دائن</th>
                                <t t-foreach="state.data.accounts" t-as="acc" t-key="acc.id">
                                    <th colspan="2" class="text-center">
                                        <t t-esc="acc.code"/><t t-esc="' - '"/><t t-esc="acc.name"/>
                                    </th>
                                </t>
                            </tr>
                            <tr>
                                <t t-foreach="state.data.accounts" t-as="acc" t-key="acc.id">
                                    <th class="text-end small o_gl_num">من</th>
                                    <th class="text-end small o_gl_num">إلى</th>
                                </t>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="state.data.rows" t-as="row" t-key="row.move_id"
                                style="cursor:pointer;" t-custom-click="(ev, isMiddleClick) => this.openMove(row.move_id, isMiddleClick)">
                                <td class="o_gl_seq" t-esc="row.seq"/>
                                <td class="o_gl_move">
                                    <strong t-esc="row.move_name"/>
                                    <span t-if="row.state !== 'posted'"
                                          t-attf-class="badge ms-1 {{ row.state === 'draft' ? 'text-bg-secondary' : 'text-bg-warning' }}"
                                          style="font-size:9px;"
                                          t-esc="row.state === 'draft' ? 'مسودة' : 'غير مكتمل'"/>
                                </td>
                                <td class="o_gl_date" t-esc="row.date"/>
                                <td class="o_gl_ref" t-esc="row.ref"/>
                                <td class="text-end o_gl_num" t-esc="this.fmt(row.total_debit)"/>
                                <td class="text-end o_gl_num" t-esc="this.fmt(row.total_credit)"/>
                                <t t-foreach="state.data.accounts" t-as="acc" t-key="acc.id">
                                    <td class="text-end o_gl_num" t-esc="this.cell(row.amounts[acc.id], 'debit')"/>
                                    <td class="text-end o_gl_num" t-esc="this.cell(row.amounts[acc.id], 'credit')"/>
                                </t>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr class="fw-bold">
                                <td colspan="4" class="text-end">الإجمالي</td>
                                <td class="text-end o_gl_num" t-esc="this.fmt(state.data.grand_debit)"/>
                                <td class="text-end o_gl_num" t-esc="this.fmt(state.data.grand_credit)"/>
                                <t t-foreach="state.data.accounts" t-as="acc" t-key="acc.id">
                                    <td class="text-end o_gl_num" t-esc="this.cell(state.data.totals[acc.id], 'debit')"/>
                                    <td class="text-end o_gl_num" t-esc="this.cell(state.data.totals[acc.id], 'credit')"/>
                                </t>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </t>
        </div>
    </t>

</templates>
