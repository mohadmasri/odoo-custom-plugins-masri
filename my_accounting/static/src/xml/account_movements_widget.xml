<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="my_accounting.AccountMovementsPanel">
        <div class="o_account_movements_panel">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div class="d-flex flex-wrap align-items-end" style="gap: 12px;">
                    <div>
                        <label class="d-block small text-muted mb-1">رقم القيد</label>
                        <input type="text" class="form-control form-control-sm" style="width:140px;"
                               placeholder="بحث..." t-att-value="state.moveName"
                               t-on-input="(ev) => this.onTextInput('moveName', ev)"/>
                    </div>
                    <div>
                        <label class="d-block small text-muted mb-1">من تاريخ</label>
                        <input type="date" class="form-control form-control-sm" style="width:150px;"
                               t-att-value="state.filter.dateFrom"
                               t-on-change="(ev) => this.onFilterChange('dateFrom', ev)"/>
                    </div>
                    <div>
                        <label class="d-block small text-muted mb-1">إلى تاريخ</label>
                        <input type="date" class="form-control form-control-sm" style="width:150px;"
                               t-att-value="state.filter.dateTo"
                               t-on-change="(ev) => this.onFilterChange('dateTo', ev)"/>
                    </div>
                    <div>
                        <label class="d-block small text-muted mb-1">من قيد</label>
                        <input type="text" class="form-control form-control-sm" style="width:120px;"
                               list="o_account_movements_move_names" placeholder="رقم القيد"
                               t-att-value="state.filter.moveFrom"
                               t-on-change="(ev) => this.onFilterChange('moveFrom', ev)"/>
                    </div>
                    <div>
                        <label class="d-block small text-muted mb-1">إلى قيد</label>
                        <input type="text" class="form-control form-control-sm" style="width:120px;"
                               list="o_account_movements_move_names" placeholder="آخر قيد"
                               t-att-value="state.filter.moveTo"
                               t-on-change="(ev) => this.onFilterChange('moveTo', ev)"/>
                    </div>
                    <datalist id="o_account_movements_move_names">
                        <option t-foreach="state.moveNames" t-as="moveName" t-key="moveName_index" t-att-value="moveName"/>
                    </datalist>
                    <div>
                        <label class="d-block small text-muted mb-1">من شهر دفتر الأستاذ</label>
                        <input type="month" class="form-control form-control-sm" style="width:160px;"
                               t-att-value="state.filter.ledgerFrom"
                               t-on-change="(ev) => this.onFilterChange('ledgerFrom', ev)"/>
                    </div>
                    <div>
                        <label class="d-block small text-muted mb-1">إلى شهر دفتر الأستاذ</label>
                        <input type="month" class="form-control form-control-sm" style="width:160px;"
                               t-att-value="state.filter.ledgerTo"
                               t-on-change="(ev) => this.onFilterChange('ledgerTo', ev)"/>
                    </div>
                    <div>
                        <label class="d-block small text-muted mb-1">المرجع</label>
                        <input type="text" class="form-control form-control-sm" style="width:140px;"
                               placeholder="بحث..." t-att-value="state.ref"
                               t-on-input="(ev) => this.onTextInput('ref', ev)"/>
                    </div>
                    <div t-if="state.childAccounts.length > 1">
                        <label class="d-block small text-muted mb-1">الحساب</label>
                        <select class="form-select form-select-sm" style="width:180px;"
                                t-on-change="(ev) => this.onAccountFilter(ev)">
                            <option value="" t-att-selected="!state.accountFilter">كل الحسابات (شامل الفرعية)</option>
                            <t t-foreach="state.childAccounts" t-as="acc" t-key="acc.id">
                                <option t-att-value="acc.id" t-att-selected="state.accountFilter === acc.id">
                                    <t t-esc="acc.code"/><t t-esc="' - '"/><t t-esc="acc.name"/>
                                </option>
                            </t>
                        </select>
                    </div>
                    <div>
                        <button class="btn btn-sm btn-link" t-on-click="() => this.clearFilters()">
                            <i class="fa fa-times me-1"/> مسح الفلاتر
                        </button>
                    </div>
                </div>
                <button class="btn btn-secondary" t-on-click="() => this.printStatement()">
                    <i class="fa fa-print me-1"/> طباعة
                </button>
            </div>

            <div t-if="hasFilter and state.resolved" class="alert alert-info py-2 px-3 mb-3 small d-flex align-items-center" style="gap: 8px;">
                <i class="fa fa-filter"/>
                <div class="flex-grow-1">
                    <strong t-if="fromTree">فلتر شجرة الحسابات مطبّق:</strong>
                    <strong t-else="">فلتر الحركة مطبّق:</strong>
                    <t t-if="state.resolved.date_to">
                        من تاريخ <strong><bdi t-esc="state.filter.dateFrom or 'البداية'"/></strong>
                        إلى <strong><bdi t-esc="state.resolved.date_to"/></strong>
                    </t>
                    <t t-if="state.resolved.date_to and state.resolved.move_to"> • </t>
                    <t t-if="state.resolved.move_to">
                        من قيد <strong><bdi t-esc="state.resolved.move_from"/></strong>
                        إلى قيد <strong><bdi t-esc="state.resolved.move_to"/></strong>
                    </t>
                    <t t-if="state.resolved.ledger_to and (state.resolved.date_to or state.resolved.move_to)"> • </t>
                    <t t-if="state.resolved.ledger_to">
                        من شهر أستاذ <strong><bdi t-esc="state.filter.ledgerFrom or 'البداية'"/></strong>
                        إلى <strong><bdi t-esc="state.resolved.ledger_to"/></strong>
                    </t>
                </div>
                <button class="btn btn-sm btn-outline-secondary" t-on-click="() => this.clearMovementFilter()">
                    <i class="fa fa-times me-1"/> إلغاء الفلترة
                </button>
            </div>

            <table class="table table-hover table-sm">
                <thead>
                    <tr>
                        <th>التاريخ</th>
                        <th>القيد</th>
                        <th>الحساب</th>
                        <th>البيان</th>
                        <th class="text-end">مدين</th>
                        <th class="text-end">دائن</th>
                        <th>الحالة</th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-if="!state.records.length">
                        <td colspan="7" class="text-center text-muted py-4">لا توجد حركات مطابقة</td>
                    </tr>
                    <tr t-foreach="state.records" t-as="rec" t-key="rec.id"
                        style="cursor:pointer;" t-on-click="() => this.openMove(rec.move_id[0])">
                        <td t-esc="rec.date"/>
                        <td><strong t-esc="rec.move_id[1]"/></td>
                        <td t-esc="rec.account_id[1]"/>
                        <td t-esc="rec.name or ''"/>
                        <td class="text-end" t-esc="rec.debit ? rec.debit.toFixed(3) : ''"/>
                        <td class="text-end" t-esc="rec.credit ? rec.credit.toFixed(3) : ''"/>
                        <td>
                            <span t-attf-class="badge {{ rec.move_state === 'posted' ? 'text-bg-success' : 'text-bg-info' }}"
                                  t-esc="stateLabels[rec.move_state]"/>
                        </td>
                    </tr>
                </tbody>
                <tfoot t-if="state.records.length">
                    <tr class="fw-bold" style="border-top: 2px solid var(--border-color, #dee2e6);">
                        <td colspan="4" class="text-end">الإجمالي</td>
                        <td class="text-end" t-esc="totalDebit.toFixed(3)"/>
                        <td class="text-end" t-esc="totalCredit.toFixed(3)"/>
                        <td/>
                    </tr>
                </tfoot>
            </table>
        </div>
    </t>

</templates>
