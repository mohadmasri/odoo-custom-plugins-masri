<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="my_accounting.AccountTree">
        <div class="o_account_tree_page p-4" style="overflow:auto; height:100%;">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="m-0">شجرة الحسابات</h2>
                    <div class="text-muted small mt-1">إدارة الحسابات وتنظيمها الهرمي</div>
                </div>
                <div class="d-flex" style="gap: 8px;">
                    <button class="btn btn-outline-secondary" t-on-click="() => this.openReview()">
                        <i class="fa fa-check-square-o me-1"/> مراجعة الحسابات
                    </button>
                    <button class="btn btn-outline-primary" t-on-click="() => this.openBulkCreateDialog(false)">
                        <i class="fa fa-list-ul me-1"/> إضافة حسابات متعددة
                    </button>
                    <button class="btn btn-primary" t-on-click="() => this.createAccount(false)">
                        <i class="fa fa-plus me-1"/> حساب جديد
                    </button>
                </div>
            </div>

            <div class="o_account_tree_filters mb-3">
                <div class="o_account_tree_search position-relative mb-2">
                    <i class="fa fa-search o_account_tree_search_icon"/>
                    <input type="search" class="form-control"
                           placeholder="بحث ذكي عن حساب بالاسم أو الرمز (مثال: صندوق، بنك الاهلي، 101)..."
                           t-att-value="state.search" t-on-input="(ev) => this.onSearchInput(ev)"/>
                </div>
                <PeriodFilter year="filterYear" month="filterMonth" allowAllYears="true"
                                  onChange.bind="onPeriodChange"/>

                <div class="d-flex flex-wrap align-items-end" style="gap: 10px;">
                    <div>
                        <label class="form-label small mb-1">من تاريخ</label>
                        <input type="date" class="form-control form-control-sm" t-model="state.filterForm.dateFrom"
                               t-on-keydown="(ev) => this.onFilterKeydown(ev)"/>
                    </div>
                    <div>
                        <label class="form-label small mb-1">إلى تاريخ <span class="text-muted">(افتراضياً اليوم)</span></label>
                        <input type="date" class="form-control form-control-sm" t-model="state.filterForm.dateTo"
                               t-on-keydown="(ev) => this.onFilterKeydown(ev)"/>
                    </div>
                    <div class="o_account_tree_filter_sep"/>
                    <div>
                        <label class="form-label small mb-1">من قيد</label>
                        <input type="text" class="form-control form-control-sm" list="o_account_tree_move_names"
                               placeholder="رقم القيد" t-model="state.filterForm.moveFrom"
                               t-on-keydown="(ev) => this.onFilterKeydown(ev)"/>
                    </div>
                    <div>
                        <label class="form-label small mb-1">إلى قيد <span class="text-muted">(افتراضياً آخر قيد)</span></label>
                        <input type="text" class="form-control form-control-sm" list="o_account_tree_move_names"
                               placeholder="رقم القيد" t-model="state.filterForm.moveTo"
                               t-on-keydown="(ev) => this.onFilterKeydown(ev)"/>
                    </div>
                    <div class="o_account_tree_filter_sep"/>
                    <div>
                        <label class="form-label small mb-1">من شهر دفتر الأستاذ</label>
                        <input type="month" class="form-control form-control-sm" t-model="state.filterForm.ledgerFrom"
                               t-on-keydown="(ev) => this.onFilterKeydown(ev)"/>
                    </div>
                    <div>
                        <label class="form-label small mb-1">إلى شهر دفتر الأستاذ <span class="text-muted">(افتراضياً الشهر الحالي)</span></label>
                        <input type="month" class="form-control form-control-sm" t-model="state.filterForm.ledgerTo"
                               t-on-keydown="(ev) => this.onFilterKeydown(ev)"/>
                    </div>
                    <datalist id="o_account_tree_move_names">
                        <option t-foreach="state.moveNames" t-as="moveName" t-key="moveName_index" t-att-value="moveName"/>
                    </datalist>
                    <button class="btn btn-sm btn-primary" t-on-click="() => this.applyFilter()">
                        <i class="fa fa-filter me-1"/> تطبيق الفلتر
                    </button>
                    <button t-if="state.filter or hasFilterInput" class="btn btn-sm btn-outline-secondary"
                            t-on-click="() => this.clearFilter()">
                        <i class="fa fa-times me-1"/> مسح الفلتر
                    </button>
                </div>
                <div t-if="state.filter" class="alert alert-info py-2 px-3 mt-2 mb-0 small d-flex align-items-center" style="gap: 8px;">
                    <i class="fa fa-filter"/>
                    <div>
                        <div>
                            <strong>الحسابات التي عليها حركة:</strong>
                            <t t-if="state.filter.dateTo">
                                من تاريخ <strong><bdi t-esc="state.filter.dateFrom or 'البداية'"/></strong>
                                إلى <strong><bdi t-esc="state.filter.dateTo"/></strong>
                            </t>
                            <t t-if="state.filter.dateTo and state.filter.moveTo"> • </t>
                            <t t-if="state.filter.moveTo">
                                من قيد <strong><bdi t-esc="state.filter.moveFrom"/></strong>
                                إلى قيد <strong><bdi t-esc="state.filter.moveTo"/></strong>
                            </t>
                            <t t-if="state.filter.ledgerTo and (state.filter.dateTo or state.filter.moveTo)"> • </t>
                            <t t-if="state.filter.ledgerTo">
                                من شهر أستاذ <strong><bdi t-esc="state.filter.ledgerFrom or 'البداية'"/></strong>
                                إلى <strong><bdi t-esc="state.filter.ledgerTo"/></strong>
                            </t>
                            — <bdi t-esc="movementAccountsCount"/> حساب
                        </div>
                        <div class="opacity-75">عمود الرصيد يعرض صافي الحركة ضمن الفلتر، والطباعة تشمل حركات الفلتر فقط.</div>
                    </div>
                </div>
            </div>

            <div t-if="selectedIds.length" class="o_account_bulk_toolbar d-flex align-items-center mb-2 p-2"
                 style="gap: 10px; border-radius: 6px;">
                <span class="small fw-bold" t-esc="`تم تحديد ${printableIds.length} حساب`"/>
                <span t-if="printableIds.length !== selectedIds.length" class="small text-muted"
                      t-esc="`(${selectedIds.length - printableIds.length} محدد مخفي بالفلتر/البحث ولن يُطبع)`"/>
                <button class="btn btn-sm btn-outline-primary" t-att-disabled="!printableIds.length"
                        t-on-click="() => this.printSelected()">
                    <i class="fa fa-print me-1"/>
                    <t t-if="state.filter">طباعة المحدد حسب الفلتر</t>
                    <t t-else="">طباعة المحدد</t>
                </button>
                <button class="btn btn-sm btn-link ms-auto" t-on-click="() => this.clearSelection()">
                    إلغاء التحديد
                </button>
            </div>

            <div class="o_account_tree_card">
                <div class="d-flex fw-bold o_account_tree_header">
                    <div style="width:30px;" class="text-center">
                        <input type="checkbox" class="form-check-input"
                               t-att-checked="allSelected"
                               t-on-change="(ev) => this.toggleSelectAll(ev)"/>
                    </div>
                    <div class="flex-grow-1">الحساب</div>
                    <div style="width:130px;" class="text-end">
                        <t t-if="state.filter">صافي الحركة</t>
                        <t t-else="">الرصيد</t>
                    </div>
                    <div style="width:40px;"/>
                </div>
                <div t-if="!state.roots.length" class="text-muted text-center py-5">
                    لا توجد حسابات بعد. اضغط "حساب جديد" للبدء.
                </div>
                <t t-set="shownRoots" t-value="displayRoots"/>
                <div t-if="state.roots.length and !shownRoots.length" class="text-muted text-center py-5">
                    <t t-if="state.filter">لا توجد حسابات عليها حركة ضمن هذا الفلتر</t>
                    <t t-else="">لا توجد حسابات مطابقة للبحث</t>
                </div>
                <t t-foreach="shownRoots" t-as="root" t-key="root.id">
                    <AccountTreeNode node="root" depth="0" expanded="state.expanded" selected="state.selected"
                        filterActive="!!state.filter"
                        onToggle="(id) => this.toggle(id)"
                        onOpen="(id) => this.openAccount(id)"
                        onAddChild="(id) => this.createAccount(id)"
                        onToggleSelect="(id, checked) => this.toggleSelect(id, checked)"/>
                </t>
            </div>
        </div>
    </t>

    <t t-name="my_accounting.AccountTreeNode">
        <div class="o_account_tree_node">
            <div class="d-flex align-items-center o_account_tree_row"
                 t-attf-class="{{ props.depth === 0 ? 'o_account_tree_row_root' : '' }}"
                 t-att-style="indentStyle">
                <div style="width:30px;" class="text-center flex-shrink-0">
                    <input type="checkbox" class="form-check-input"
                           t-att-checked="props.selected[node.id] || false"
                           t-on-change="(ev) => props.onToggleSelect(node.id, ev.target.checked)"/>
                </div>
                <span t-if="hasChildren" class="o_account_tree_caret"
                      t-on-click.stop="() => props.onToggle(node.id)">
                    <i t-attf-class="fa {{ isExpanded ? 'fa-caret-down' : 'fa-caret-right' }}"/>
                </span>
                <span t-else="" class="o_account_tree_caret"/>
                <span class="flex-grow-1 o_account_tree_label" t-on-click="() => props.onOpen(node.id)"
                      t-att-class="{ 'o_account_tree_no_movement': props.filterActive and !node.hasMovement }">
                    <span class="o_account_tree_code" t-esc="node.code"/>
                    <span t-att-class="{ 'o_account_tree_match': node.matched }" t-esc="node.name"/>
                    <span t-if="props.filterActive and node.hasMovement" class="badge text-bg-light border ms-2"
                          style="font-size:10px;" t-esc="`${node.movementCount} حركة`"/>
                    <span t-if="node.reviewed" class="badge text-bg-success ms-2" style="font-size:10px;">
                        <i class="fa fa-check me-1"/>تمت المراجعة
                    </span>
                </span>
                <div style="width:130px;" t-attf-class="text-end o_account_tree_balance {{ balanceClass }}"
                     t-esc="formattedBalance"/>
                <div style="width:40px;" class="text-center o_account_tree_add">
                    <a href="#" class="text-muted" title="إضافة حساب فرعي"
                       t-on-click.stop.prevent="() => props.onAddChild(node.id)">
                        <i class="fa fa-plus"/>
                    </a>
                </div>
            </div>
            <t t-if="isExpanded">
                <t t-foreach="node.children" t-as="child" t-key="child.id">
                    <AccountTreeNode node="child" depth="props.depth + 1" expanded="props.expanded" selected="props.selected"
                        filterActive="props.filterActive"
                        onToggle="props.onToggle" onOpen="props.onOpen" onAddChild="props.onAddChild"
                        onToggleSelect="props.onToggleSelect"/>
                </t>
            </t>
        </div>
    </t>

</templates>
