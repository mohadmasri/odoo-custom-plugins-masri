<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="my_accounting.HomeNavCard">
        <div class="o_home_nav" t-att-style="'grid-area: ' + area" t-on-click="card.action">
            <div class="o_myaccounting_home_icon" t-attf-style="background-color: {{ card.color }}1a; color: {{ card.color }};">
                <i t-attf-class="fa {{ card.icon }}"/>
            </div>
            <div class="o_myaccounting_home_title" t-esc="card.title"/>
            <div class="o_myaccounting_home_desc" t-esc="card.desc"/>
        </div>
    </t>

    <t t-name="my_accounting.Home">
        <div class="o_myaccounting_home p-4" style="overflow:auto; height:100%;">
            <div class="mb-4">
                <h2 class="m-0">المحاسبة المخصصة</h2>
            </div>

            <!-- التخطيط مطابق للنموذج: بطاقات التنقل يساراً، قائمة التذكير يميناً،
                 وأربعة مربعات مؤشرات في الأسفل -->
            <div class="o_home_layout">
                <t t-call="my_accounting.HomeNavCard">
                    <t t-set="card" t-value="navCards.newMove"/><t t-set="area" t-value="'newmove'"/>
                </t>
                <t t-call="my_accounting.HomeNavCard">
                    <t t-set="card" t-value="navCards.moves"/><t t-set="area" t-value="'moves'"/>
                </t>
                <t t-call="my_accounting.HomeNavCard">
                    <t t-set="card" t-value="navCards.accounts"/><t t-set="area" t-value="'accounts'"/>
                </t>
                <t t-call="my_accounting.HomeNavCard">
                    <t t-set="card" t-value="navCards.ledger"/><t t-set="area" t-value="'ledger'"/>
                </t>

                <div class="o_home_todo" style="grid-area: todo;">
                    <div class="o_home_todo_head">
                        <div>
                            <div class="o_home_todo_title"><i class="fa fa-bell-o me-2"/>قائمة التذكير</div>
                            <div class="o_home_todo_sub">to do list</div>
                        </div>
                        <button class="btn btn-sm btn-link p-0" t-on-click="() => this.openTodoApp()">
                            فتح تطبيق المهام
                        </button>
                    </div>
                    <t t-if="state.todosAllowed">
                        <div class="o_home_todo_add">
                            <input type="text" class="form-control form-control-sm"
                                   placeholder="أضف تذكيراً جديداً ثم اضغط Enter"
                                   t-att-value="state.newTodo"
                                   t-on-input="(ev) => { state.newTodo = ev.target.value; }"
                                   t-on-keydown="(ev) => this.onTodoKeydown(ev)"/>
                            <button class="btn btn-sm btn-primary" t-on-click="() => this.addTodo()">
                                <i class="fa fa-plus"/>
                            </button>
                        </div>
                        <div class="o_home_todo_list">
                            <div t-if="!state.todos.length" class="text-muted text-center py-4 small">
                                لا توجد تذكيرات حالياً
                            </div>
                            <div t-foreach="state.todos" t-as="todo" t-key="todo.id" class="o_home_todo_item">
                                <input type="checkbox" class="form-check-input" title="تم الإنجاز"
                                       t-on-change="() => this.completeTodo(todo)"/>
                                <i t-if="todo.starred" class="fa fa-star text-warning"/>
                                <span t-esc="todo.name"/>
                            </div>
                        </div>
                    </t>
                    <div t-else="" class="text-muted text-center py-4 small">
                        لا تملك صلاحية تطبيق المهام.
                    </div>
                </div>

                <t t-foreach="statBoxes" t-as="box" t-key="box.key">
                    <div class="o_home_stat" t-att-style="'grid-area: ' + box.key"
                         t-on-click="() => this.openStat(box)">
                        <div class="o_home_stat_icon" t-attf-style="color: {{ box.color }};">
                            <i t-attf-class="fa {{ box.icon }}"/>
                        </div>
                        <div class="o_home_stat_title" t-esc="box.title"/>
                        <div class="o_home_stat_value" t-attf-style="color: {{ box.color }};">
                            <t t-if="state.stats" t-esc="box.value(state.stats)"/>
                            <t t-else="">—</t>
                        </div>
                        <div t-if="state.stats" class="o_home_stat_hint" t-esc="box.hint(state.stats)"/>
                    </div>
                </t>
            </div>

            <!-- التقارير التي اختارها المستخدم من صفحة التقارير (📌) -->
            <HomeReports/>
        </div>
    </t>

</templates>
