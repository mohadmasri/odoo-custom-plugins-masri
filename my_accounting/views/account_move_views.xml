<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

    <record id="view_myaccounting_move_list" model="ir.ui.view">
        <field name="name">myaccounting.move.list</field>
        <field name="model">myaccounting.move</field>
        <field name="arch" type="xml">
            <list string="القيود المحاسبية" decoration-muted="state == 'draft'">
                <field name="has_import_notes" column_invisible="1"/>
                <field name="name" decoration-warning="has_import_notes" decoration-bf="has_import_notes"/>
                <field name="date"/>
                <field name="ledger_period_label" string="الشهر المحاسبي"/>
                <field name="ref"/>
                <field name="journal"/>
                <field name="total_debit" sum="الإجمالي" digits="[16,3]"/>
                <field name="total_credit" sum="الإجمالي" digits="[16,3]"/>
                <field name="state" widget="badge" decoration-success="state == 'posted'"
                       decoration-info="state == 'draft'" decoration-warning="state == 'incomplete'"/>
            </list>
        </field>
    </record>

    <record id="view_myaccounting_move_form" model="ir.ui.view">
        <field name="name">myaccounting.move.form</field>
        <field name="model">myaccounting.move</field>
        <field name="arch" type="xml">
            <form string="قيد محاسبي" js_class="myaccounting_move_form">
                <header>
                    <button name="action_post" type="object" string="ترحيل" class="oe_highlight"
                            invisible="state == 'posted'"/>
                    <button name="action_post_and_next" type="object" string="ترحيل والتالي"
                            icon="fa-forward" invisible="state == 'posted'"/>
                    <button name="action_reset_to_draft" type="object" string="إعادة إلى مسودة"
                            invisible="state == 'draft'"/>
                    <button name="%(action_report_myaccounting_move)d" type="action"
                            string="طباعة" icon="fa-print" invisible="move_type == 'receipt'"/>
                    <button name="%(action_report_myaccounting_receipt)d" type="action"
                            string="طباعة السند" icon="fa-print" invisible="move_type != 'receipt'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <field name="has_import_notes" invisible="1"/>
                    <field name="move_type" invisible="1"/>
                    <div class="oe_title" invisible="move_type != 'receipt'">
                        <h3 class="text-muted m-0">سند قبض</h3>
                    </div>
                    <div class="alert alert-warning o_myaccounting_import_notes" role="alert"
                         invisible="not has_import_notes">
                        <div class="d-flex align-items-start gap-2">
                            <i class="fa fa-exclamation-triangle fa-lg mt-1" title="ملاحظات الاستيراد"/>
                            <div class="flex-grow-1">
                                <field name="import_notes" readonly="1" nolabel="1"/>
                                <div class="small text-muted">هذه الملاحظات محفوظة أيضاً في تبويب "ملاحظة" في المحادثة أسفل القيد.</div>
                            </div>
                            <button name="action_mark_import_notes_reviewed" type="object"
                                    string="تمت المراجعة" icon="fa-check" class="btn btn-sm btn-secondary"/>
                        </div>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="state == 'posted'" placeholder="رقم القيد"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="ref"/>
                        </group>
                        <group>
                            <field name="journal" widget="myaccounting_journal"/>
                            <field name="ledger_month" string="شهر دفتر الأستاذ"/>
                            <field name="ledger_year" string="سنة دفتر الأستاذ"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="بنود القيد">
                            <field name="line_ids" readonly="state == 'posted'">
                                <list editable="bottom">
                                    <field name="sequence" widget="myaccounting_line_order" string=" "/>
                                    <field name="account_label" column_invisible="1"/>
                                    <field name="move_state" column_invisible="1"/>
                                    <field name="account_id" widget="myaccounting_account_selector"/>
                                    <field name="pending_account_name" string="اسم الحساب في الملف"
                                           readonly="1" optional="show"/>
                                    <field name="name"/>
                                    <field name="debit" sum="إجمالي المدين" digits="[16,3]"/>
                                    <field name="credit" sum="إجمالي الدائن" digits="[16,3]"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="total_debit"/>
                                <field name="total_credit"/>
                                <field name="is_balanced" widget="boolean_toggle" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_myaccounting_move_search" model="ir.ui.view">
        <field name="name">myaccounting.move.search</field>
        <field name="model">myaccounting.move</field>
        <field name="arch" type="xml">
            <search string="بحث في القيود">
                <field name="name" string="القيد"
                       filter_domain="['|', ('name', 'ilike', self), ('ref', 'ilike', self)]"/>
                <field name="ref"/>
                <field name="journal"/>
                <field name="date"/>
                <field name="date" string="من تاريخ" operator="&gt;="/>
                <field name="date" string="إلى تاريخ" operator="&lt;="/>
                <field name="line_ids" string="الحساب"
                       filter_domain="['|', '|', ('line_ids.account_id.code', 'ilike', self), ('line_ids.account_id.name', 'ilike', self), ('line_ids.pending_account_name', 'ilike', self)]"/>
                <filter string="مسودة" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="غير مكتمل" name="incomplete" domain="[('state', '=', 'incomplete')]"/>
                <filter string="مرحّل" name="posted" domain="[('state', '=', 'posted')]"/>
                <separator/>
                <filter string="بملاحظات استيراد" name="has_import_notes" domain="[('has_import_notes', '=', True)]"/>
                <separator/>
                <filter string="متوازن" name="balanced" domain="[('is_balanced', '=', True)]"/>
                <filter string="غير متوازن" name="unbalanced" domain="[('is_balanced', '=', False)]"/>
                <group>
                    <filter string="الحالة" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="اليومية" name="group_journal" context="{'group_by': 'journal'}"/>
                    <filter string="الشهر" name="group_month" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_myaccounting_move" model="ir.actions.act_window">
        <field name="name">القيود المحاسبية</field>
        <field name="res_model">myaccounting.move</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_myaccounting_move_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                أنشئ أول قيد محاسبي
            </p>
        </field>
    </record>

    </data>
</odoo>
