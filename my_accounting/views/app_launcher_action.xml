<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

    <record id="action_app_launcher" model="ir.actions.client">
        <field name="name">التطبيقات الفعالة</field>
        <field name="tag">my_accounting.app_launcher</field>
    </record>

    <record id="action_myaccounting_account_tree" model="ir.actions.client">
        <field name="name">شجرة الحسابات</field>
        <field name="tag">my_accounting.account_tree</field>
    </record>

    <record id="action_myaccounting_move_list" model="ir.actions.client">
        <field name="name">القيود المحاسبية</field>
        <field name="tag">my_accounting.move_list</field>
    </record>

    <record id="action_myaccounting_general_ledger" model="ir.actions.client">
        <field name="name">دفتر الأستاذ العام</field>
        <field name="tag">my_accounting.general_ledger</field>
    </record>

    <record id="action_myaccounting_trial_balance" model="ir.actions.client">
        <field name="name">ميزان المراجعة</field>
        <field name="tag">my_accounting.trial_balance</field>
    </record>

    <record id="action_myaccounting_home" model="ir.actions.client">
