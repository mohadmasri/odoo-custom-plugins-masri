    </record>

    <record id="action_myaccounting_user_admin" model="ir.actions.client">
        <field name="name">إدارة المستخدمين</field>
        <field name="tag">my_accounting.user_admin</field>
    </record>

    <record id="action_myaccounting_move_new_form" model="ir.actions.act_window">
        <field name="name">قيد جديد</field>
        <field name="res_model">myaccounting.move</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

    </data>
</odoo>
