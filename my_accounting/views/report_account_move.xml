<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

    <template id="report_myaccounting_move_document">
        <t t-call="web.external_layout">
            <div class="page">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <h2 class="mb-0">
                            قيد محاسبي
                            <span t-if="o.state != 'posted'" class="text-muted" style="font-size:16px;">(مسودة)</span>
                        </h2>
                        <h3 class="text-muted mt-0" t-field="o.name"/>
                    </div>
                    <div class="text-end">
                        <div><strong>التاريخ:</strong> <span t-field="o.date"/></div>
                        <div t-if="o.ref"><strong>المرجع:</strong> <span t-field="o.ref"/></div>
                    </div>
                </div>

                <table class="table table-bordered" style="width:100%;">
                    <!-- يظهر من اليمين: المدين (من) | الدائن (الى) | الحساب المدين | الحساب الدائن | البيان
                         (الصفحة من اليسار لليمين، لذلك الترتيب في الكود معكوس) -->
                    <thead style="background-color:#f2f2f2;">
                        <tr>
                            <th class="text-center">البيان</th>
                            <th class="text-center" style="width:22%;">الحساب الدائن</th>
                            <th class="text-center" style="width:22%;">الحساب المدين</th>
                            <th class="text-center" style="width:13%;">الدائن (الى)</th>
                            <th class="text-center" style="width:13%;">المدين (من)</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="o.line_ids" t-as="line">
                            <t t-set="account_text">
                                <t t-if="line.account_id"><span t-esc="line.account_id.code"/> - <span t-esc="line.account_label"/></t>
                                <t t-elif="line.pending_account_name"><span t-esc="line.pending_account_name"/> (من الملف)</t>
                            </t>
                            <td><span t-field="line.name">—</span></td>
                            <td><t t-if="line.is_credit_line" t-out="account_text"/></td>
                            <td><t t-if="not line.is_credit_line" t-out="account_text"/></td>
                            <td class="text-end">
                                <span t-if="line.credit or line.credit_zero_entered"
                                      t-field="line.credit" t-options="{'widget': 'float', 'precision': 3}"/>
                            </td>
                            <td class="text-end">
                                <span t-if="line.debit or line.debit_zero_entered"
                                      t-field="line.debit" t-options="{'widget': 'float', 'precision': 3}"/>
                            </td>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr style="background-color:#f2f2f2; font-weight:bold;">
                            <td colspan="3" class="text-end">الإجمالي</td>
                            <td class="text-end">
                                <span t-field="o.total_credit" t-options="{'widget': 'float', 'precision': 3}"/>
                            </td>
                            <td class="text-end">
                                <span t-field="o.total_debit" t-options="{'widget': 'float', 'precision': 3}"/>
                            </td>
                        </tr>
                    </tfoot>
                </table>

                <!-- سطر هذا القيد في دفتر الأستاذ العام (الحسابات المستخدمة فقط) -->
                <t t-set="ledger" t-value="o.ledger_print_cells()"/>
                <div t-if="ledger['cells']" class="mt-4">
                    <div style="font-weight:bold; margin-bottom:4px;">سطر القيد في دفتر الأستاذ العام</div>
                    <table class="table table-bordered o_move_ledger_print" style="width:100%; table-layout:fixed;">
                        <thead style="background-color:#f2f2f2;">
                            <tr>
                                <th t-foreach="ledger['cells']" t-as="cell" colspan="2" class="text-center"
                                    style="word-break:break-word;">
                                    <span t-esc="cell['title']"/>
                                </th>
                            </tr>
                            <tr>
                                <t t-foreach="ledger['cells']" t-as="cell">
                                    <th class="text-center">إلى</th>
                                    <th class="text-center">من</th>
                                </t>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <t t-foreach="ledger['cells']" t-as="cell">
                                    <td class="text-end">
                                        <span t-if="cell['credit'] or cell['credit_zero']"
                                              t-esc="cell['credit']"
                                              t-options="{'widget': 'float', 'precision': 3}"/>
                                    </td>
                                    <td class="text-end">
                                        <span t-if="cell['debit'] or cell['debit_zero']"
                                              t-esc="cell['debit']"
                                              t-options="{'widget': 'float', 'precision': 3}"/>
                                    </td>
                                </t>
                            </tr>
                        </tbody>
                    </table>
                    <div t-if="ledger['missing']" class="small text-muted">
                        <span t-esc="ledger['missing']"/> بند بلا حساب: مبلغه ضمن الإجمالي بلا خانة في الدفتر.
                    </div>
                </div>

            </div>
        </t>
    </template>

    <template id="report_myaccounting_move">
        <t t-call="web.html_container">
            <!-- كل قيد في صفحة A4 واحدة مهما كان عدد بنوده: نثبّت عرض الصفحة
                 على مقاس الطباعة، ثم نصغّر القيد بالنسبة اللازمة قبل الطباعة. -->
            <style>
                @page { size: A4 portrait; margin: 8mm; }
                .o_move_print_page {
                    width: 194mm;
                    margin: 0 auto;
                    transform-origin: top center;
                }
                /* سطر دفتر الأستاذ: يبقى ضمن عرض الصفحة مهما كثرت الحسابات */
                .o_move_ledger_print { font-size: 11px; }
                .o_move_ledger_print th,
                .o_move_ledger_print td { padding: 3px 4px; }
                @media print {
                    .o_move_print_page { break-after: page; page-break-after: always; }
                    .o_move_print_page:last-child { break-after: auto; page-break-after: auto; }
                }

                /* شريط السؤال قبل الطباعة + صفحة الفهرس وأرقام الصفحات */
                .o_mv_bar {
                    display: flex; align-items: center; gap: 10px;
                    padding: 10px 14px; margin-bottom: 10px;
                    background: #f6f6f6; border: 1px solid #ddd; border-radius: 6px;
                }
                .o_mv_bar b { margin-inline-end: 6px; }
                .o_mv_index { width: 194mm; margin: 0 auto; font-size: 12px; }
                .o_mv_index h2 { font-size: 18px; margin-bottom: 8px; }
                .o_mv_index table { width: 100%; }
                .o_mv_index th { background-color: #f2f2f2; }
                .o_mv_index .o_mv_page_col { width: 70px; text-align: center; }
                .o_mv_stamp { text-align: end; font-size: 10px; color: #666; }
                @media print {
                    .o_mv_bar { display: none !important; }
                    .o_mv_index { break-after: page; page-break-after: always; }
                }
            </style>
            <t t-set="cfg" t-value="env['myaccounting.print.index'].get_settings()"/>

            <!-- السؤال قبل الطباعة (حسب الإعدادات). زر "بلا فهرس" يطبع مباشرة
                 حتى لو تعطّل أي كود آخر. -->
            <div class="o_mv_bar" t-if="cfg['mode'] == 'ask'">
                <b>الطباعة:</b>
                <button type="button" class="btn btn-primary btn-sm" id="o_mv_with">
                    طباعة مع فهرس
                </button>
                <button type="button" class="btn btn-secondary btn-sm" onclick="window.print()">
                    طباعة بلا فهرس
                </button>
                <span class="text-muted small">الفهرس صفحة أولى تسرد القيود المطبوعة وأرقام صفحاتها.</span>
            </div>

            <!-- الفهرس مبنيّ هنا ومخفي، ولا يظهر إلا إذا اختير -->
            <div class="o_mv_index" id="o_mv_index" style="display:none;"
                 t-att-data-stamp="cfg['stamp_pages'] and '1' or '0'"
                 t-att-data-auto="cfg['mode']">
                <h2><t t-esc="cfg['move_title']"/></h2>
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th t-if="cfg['move_show_seq']" style="width:60px;">#</th>
                            <th t-if="cfg['move_show_name']" style="width:110px;">رقم القيد</th>
                            <th t-if="cfg['move_show_date']" style="width:110px;">التاريخ</th>
                            <th t-if="cfg['move_show_ref']">المرجع</th>
                            <th t-if="cfg['move_show_total']" style="width:120px;" class="text-end">الإجمالي</th>
                            <th class="o_mv_page_col">الصفحة</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="docs" t-as="o">
                            <td t-if="cfg['move_show_seq']"><t t-esc="o_index + 1"/></td>
                            <td t-if="cfg['move_show_name']"><t t-esc="o.name or '—'"/></td>
                            <td t-if="cfg['move_show_date']"><t t-esc="o.date"/></td>
                            <td t-if="cfg['move_show_ref']"><t t-esc="o.ref or '—'"/></td>
                            <td t-if="cfg['move_show_total']" class="text-end">
                                <t t-esc="'%.3f' % o.total_debit"/>
                            </td>
                            <td class="o_mv_page_col"/>
                        </tr>
                    </tbody>
                </table>
            </div>

            <t t-foreach="docs" t-as="o">
                <div class="o_move_print_page">
                    <t t-call="my_accounting.report_myaccounting_move_document"/>
                </div>
            </t>
            <script>
                window.addEventListener('load', function () {
                    var MM_TO_PX = 96 / 25.4;
                    var availableHeight = (297 - 16) * MM_TO_PX; // A4 عمودي ناقص الهوامش
                    var pageWidthMm = 194;                       // عرض الورقة بين الهوامش
                    document.querySelectorAll('.o_move_print_page').forEach(function (page) {
                        // التكبير يوسّع الصفحة أيضاً، فنضيّق عرضها بنفس النسبة
                        // حتى يبقى العرض المطبوع 194 مم مهما كبر القيد أو صغر،
                        // فلا يخرج أي عمود خارج الورقة.
                        var apply = function (zoom) {
                            page.style.width = (pageWidthMm / zoom).toFixed(3) + 'mm';
                            page.style.zoom = zoom.toFixed(4);
                        };
                        var zoom = 1;
                        apply(zoom);
                        // نملأ الصفحة: نكبّر القيد الصغير ونصغّر الكبير. التغيير
                        // يعيد تنسيق النص، فنكرّر القياس حتى يستقر.
                        for (var i = 0; i &lt; 12; i++) {
                            var height = page.getBoundingClientRect().height;
                            if (!height) {
                                break;
                            }
                            var target = zoom * (availableHeight / height) * 0.99;
                            target = Math.min(Math.max(target, 0.05), 2.5);
                            if (Math.abs(target - zoom) &lt; 0.01) {
                                break;
                            }
                            zoom = target;
                            apply(zoom);
                        }
                        // ضمان أخير: لا يتجاوز المحتوى ارتفاع الصفحة
                        for (var j = 0; j &lt; 20; j++) {
                            if (page.getBoundingClientRect().height &lt;= availableHeight || zoom &lt;= 0.05) {
                                break;
                            }
                            zoom = Math.max(zoom * 0.96, 0.05);
                            apply(zoom);
                        }
                    });
                    maAfterFit();
                });

                // الفهرس: صفحة أولى تسرد القيود وأرقام صفحاتها
                function maBuildIndex() {
                    try {
                        var MM_TO_PX = 96 / 25.4;
                        var pageH = (297 - 16) * MM_TO_PX;
                        var index = document.getElementById('o_mv_index');
                        index.style.display = '';
                        var stamping = index.getAttribute('data-stamp') === '1';
                        var pages = document.querySelectorAll('.o_move_print_page');
                        var cells = index.querySelectorAll('tbody .o_mv_page_col');
                        var page = 1 + Math.max(1, Math.ceil(
                            index.getBoundingClientRect().height / pageH - 0.02));
                        for (var i = 0; i &lt; pages.length; i++) {
                            if (cells[i]) {
                                cells[i].textContent = page;
                            }
                            if (stamping) {
                                var stamp = document.createElement('div');
                                stamp.className = 'o_mv_stamp';
                                stamp.textContent = 'صفحة ' + page;
                                pages[i].insertBefore(stamp, pages[i].firstChild);
                            }
                            page += Math.max(1, Math.ceil(
                                pages[i].getBoundingClientRect().height / pageH - 0.02));
                        }
                    } catch (error) {
                        // أي خلل في الترقيم لا يمنع الطباعة
                    }
                    var bar = document.querySelector('.o_mv_bar');
                    if (bar) {
                        bar.style.display = 'none';
                    }
                }

                // بعد ضبط المقاس: إما ننتظر اختيار المستخدم أو نطبع مباشرة
                function maAfterFit() {
                    var button = document.getElementById('o_mv_with');
                    if (button) {
                        button.addEventListener('click', function () {
                            maBuildIndex();
                            window.print();
                        });
                        return;
                    }
                    if (document.getElementById('o_mv_index').getAttribute('data-auto') === 'always') {
                        maBuildIndex();
                    }
                    window.print();
                }
            </script>
        </t>
    </template>

    <record id="action_report_myaccounting_move" model="ir.actions.report">
        <field name="name">طباعة القيد المحاسبي</field>
        <field name="model">myaccounting.move</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">my_accounting.report_myaccounting_move</field>
        <field name="report_file">my_accounting.report_myaccounting_move</field>
        <field name="print_report_name">'قيد محاسبي - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_myaccounting_move"/>
        <field name="binding_type">report</field>
    </record>

    </data>
</odoo>
